---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { route } from '../utils/route';

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonicalPath?: string;
  pageClass?: string;
  keywords?: string;
  ogImagePath?: string;
  ogType?: string;
  schemaType?: 'WebSite' | 'WebPage';
  schemaName?: string;
  schemaAlternateName?: string[];
  schemaInLanguage?: string | string[];
}

const {
  title,
  description,
  lang = 'zh-CN',
  canonicalPath = '/',
  pageClass = '',
  keywords = '琥珀评测, AMBER, AI评测, 大模型评测, 模型排行榜, AskClaw',
  ogImagePath = '/assets/top5-2026-w38.en.webp',
  ogType = 'website',
  schemaType = 'WebPage',
  schemaName = title,
  schemaAlternateName = [],
  schemaInLanguage = lang,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(route(canonicalPath), site).href;
const hasLanguagePair = canonicalPath === '/' || canonicalPath === '/en/';
const zhHome = hasLanguagePair ? new URL(route('/'), site).href : undefined;
const enHome = hasLanguagePair ? new URL(route('/en/'), site).href : undefined;
const favicon = route('/favicon.svg');
const ogImage = new URL(route(ogImagePath), site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: schemaName,
  ...(schemaAlternateName.length > 0 ? { alternateName: schemaAlternateName } : {}),
  url: canonical,
  description,
  inLanguage: schemaInLanguage,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {hasLanguagePair && <link rel="alternate" hreflang="zh-CN" href={zhHome} />}
    {hasLanguagePair && <link rel="alternate" hreflang="en" href={enHome} />}
    {hasLanguagePair && <link rel="alternate" hreflang="x-default" href={zhHome} />}
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader lang={lang} currentPath={canonicalPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
