---
import '../styles/global.css';
import '../styles/amber-skin.css';
import '../styles/side-rail.css';
import SiteHeader from '../components/SiteHeader.astro';
import ChatDrawer from '../components/ChatDrawer.astro';
import { route } from '../utils/route';
import { entitySlugs } from '../utils/lane-pages';

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonicalPath?: string;
  pageClass?: string;
  keywords?: string;
  ogImagePath?: string;
  ogType?: string;
  schemaType?: 'WebSite' | 'WebPage';
  schemaName?: string;
  schemaAlternateName?: string[];
  schemaInLanguage?: string | string[];
  /** Keep this page out of search engines even on the production root (pages awaiting launch). */
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'zh-CN',
  canonicalPath = '/',
  pageClass = '',
  keywords = '琥珀评测, AMBER, AI评测, 大模型评测, 模型排行榜, AskClaw',
  ogImagePath = '/assets/top5-2026-w41.en.webp',
  ogType = 'website',
  schemaType = 'WebPage',
  schemaName = title,
  schemaAlternateName = [],
  schemaInLanguage = lang,
  noindex = false,
} = Astro.props;

const site = Astro.site!;
const base = import.meta.env.BASE_URL;
// Preview deployments (base !== '/') are marked noindex below.
// It must never be indexed, so every page below the production root (base !== '/') carries
// noindex,nofollow. The production root build emits no robots meta at all.
const isPreviewBase = base !== '/';
const canonical = new URL(route(canonicalPath), site).href;
// /<name>/ and /en/<name>/: a model, or a provider with several lanes (src/utils/lane-pages.ts)
const entityPath = canonicalPath.match(/^(?:\/en)?\/([a-z0-9.-]+)\/$/);
const languagePair = entityPath && entitySlugs().includes(entityPath[1])
  ? { zh: `/${entityPath[1]}/`, en: `/en/${entityPath[1]}/` }
  : canonicalPath === '/claim/' || canonicalPath === '/en/claim/'
  ? { zh: '/claim/', en: '/en/claim/' }
  : canonicalPath === '/rank/' || canonicalPath === '/en/rank/'
  ? { zh: '/rank/', en: '/en/rank/' }
  : canonicalPath === '/' || canonicalPath === '/en/'
    ? { zh: '/', en: '/en/' }
    : undefined;
const hasLanguagePair = Boolean(languagePair);
const zhHome = languagePair ? new URL(route(languagePair.zh), site).href : undefined;
const enHome = languagePair ? new URL(route(languagePair.en), site).href : undefined;
// Remembers the language the visitor chose with a language link, in this browser only. Arriving from outside
// the site on a page of the other language, a visitor who chose before is sent to the same page in that
// language (the alternate links below name it). Nothing is guessed from the browser language, and crawlers have
// no stored choice, so every address keeps serving the language it is written in.
const langMemory = `(function(){try{var L=document.documentElement.lang==='en'?'en':'zh-CN',K='askclaw-lang';
document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('a[data-lang-switch]');if(a)localStorage.setItem(K,a.getAttribute('data-lang-switch'))},true);
var p=localStorage.getItem(K);if(!p||p===L)return;
var same=false;try{same=new URL(document.referrer).origin===location.origin}catch(e){}
if(same)return;
var alt=document.querySelector('link[rel=alternate][hreflang="'+p+'"]');
if(alt)location.replace(new URL(alt.href).pathname+location.search+location.hash)}catch(e){}})();`;
const faviconIco = route('/favicon.ico');
const favicon32 = route('/favicon-32.png');
const appleTouchIcon = route('/apple-touch-icon.png');
const ogImage = new URL(route(ogImagePath), site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: schemaName,
  ...(schemaAlternateName.length > 0 ? { alternateName: schemaAlternateName } : {}),
  url: canonical,
  description,
  inLanguage: schemaInLanguage,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {(isPreviewBase || noindex) && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={faviconIco} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={favicon32} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {hasLanguagePair && <link rel="alternate" hreflang="zh-CN" href={zhHome} />}
    {hasLanguagePair && <link rel="alternate" hreflang="en" href={enHome} />}
    {hasLanguagePair && <link rel="alternate" hreflang="x-default" href={zhHome} />}
    {hasLanguagePair && <script is:inline id="lang-memory" set:html={langMemory} />}
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader lang={lang} currentPath={canonicalPath} altPath={languagePair ? (lang === 'en' ? languagePair.zh : languagePair.en) : undefined} />
    <main id="main-content">
      <slot />
    </main>
    <ChatDrawer lang={lang} />
  </body>
</html>
