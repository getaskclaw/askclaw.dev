---
// The model picker (questions, tiers, cards, compare, detail). Used by the home pages (zh and en).
import '../styles/picker.css';
import rawAxes from '../data/axes.json';
import siteData from '../data/site-data.json';
import {
  axisIds, tr, labels, joinLanes, axisN, tiers, splitters, tierTitle, tierName, verdictText,
  held, displayTotal, fmtSec, fmtTok,
} from '../utils/picker-core.js';
import { I18N } from '../utils/picker-i18n.js';
import { transform } from 'esbuild';
import coreSource from '../utils/picker-core.js?raw';
import appSource from '../scripts/pick-app.js?raw';

interface Props { lang?: 'zh' | 'en' }
const { lang = 'zh' } = Astro.props;
// Axes and groups are data (amber.db axes.sql -> site-data.json); presets per group are generated,
// so adding an axis or a group needs no change here.
const zh = lang === 'zh';
const faces = siteData.axes.map((a) => [a.id, zh ? a.name_zh : a.name_en, zh ? a.hint_zh : a.hint_en]);
const groupPresets = siteData.groups.map((g) => [
  siteData.axes.filter((a) => a.grp === g.id).map((a) => a.id).join(','),
  tr(I18N[lang], 'groupPreset', { name: zh ? g.name_zh : g.name_en }),
]);
const T = { ...I18N[lang], faces, presets: [...I18N[lang].presets, ...groupPresets, ['', I18N[lang].clearPreset]] };
const LABEL = labels(T);

// Both data files are generated from amber.db (amber-run sync_site.py) and checked against
// axes.provenance.json on every build. Nothing on this page is typed in by hand.
const lanes = joinLanes(rawAxes, siteData, T);
const AXIS_N = axisN(lanes, T);
const small = (id: string) => AXIS_N[id] <= 2;
const caseTag = (id: string) => tr(T, 'cases', { n: AXIS_N[id] });
const slots = Math.max(...Object.values(AXIS_N));
const maxMed = Math.max(...lanes.filter((l) => l.e).map((l) => l.e.t_med));

// Default view (nothing selected): the same grouping the script computes, rendered at build time,
// so the page is complete without JavaScript. The script re-renders it in place on load.
const initial = tiers(lanes, [], 'time');
const pipList = (c) => [
  ...Array(c.p).fill('pip p'),
  ...Array(Math.max(0, c.n - c.p - held(c))).fill('pip'),
  ...Array(held(c)).fill('pip h'),
];
// One page script, in its own scope: this page's dictionary only, the shared core (exports
// stripped), then the page app.
// Minified at build time: Astro does not minify inline scripts, and the home page has a size budget.
const clientSource = (await transform(
  `(() => {\nconst T = ${JSON.stringify(T)};\n${coreSource.replace(/^export /gm, '')}\n${appSource}\n})();`,
  { minify: true, target: 'es2020', charset: 'utf8' },
)).code;
const sortButtons = [['time', T.sortTime, 'true'], ['tok', T.sortTok, 'false'], ['name', T.sortName, 'false']];
---
<canvas id="caustics" aria-hidden="true"></canvas>

  <div class="ctx glass" id="ctx" aria-label={T.ctxAria}>
    <button class="ctx-sum" type="button" id="ctx-sum" aria-expanded="false" aria-controls="ctx-full"></button>
    <div class="ctx-full" id="ctx-full">
      <div class="ctx-sel" id="ctx-sel"></div>
      <div class="ctx-tiers" id="ctx-tiers" aria-label={T.tiersAria}></div>
      <div class="seg" role="group" aria-label={T.sortAria}>
        {sortButtons.map(([tb, label, pressed]) => <button type="button" data-tb={tb} aria-pressed={pressed}>{label}</button>)}
      </div>
    </div>
  </div>

  <div class="page" id="pick-app" lang={lang === 'en' ? 'en' : 'zh-CN'} data-axes={JSON.stringify(rawAxes)} data-site={JSON.stringify(siteData)} style={`--slots: ${slots}`}>
    <section class="ask glass" aria-labelledby="ask-title">
      <div class="ask-main">
      <div class="ask-head">
        <h1 id="ask-title">{T.h1a}<em>{lang === 'en' ? ' ' : ''}{T.h1em}</em>{T.h1b}</h1>
        <p class="sub">{T.sub}</p>
      </div>
      <div class="pk-chips" aria-label={T.chipsAria}>
        {T.faces.map(([id, label, hint]) => (
          <button type="button" class="pk-chip" data-face={id} aria-pressed="false">
            <b>{label}{small(id) && <span class="tiny">{caseTag(id)}</span>}</b><span>{hint}</span>
          </button>
        ))}
      </div>
      <div class="presets"><span>{T.presetsLabel}</span>
        {T.presets.map(([preset, label]) => <button class="pk-preset" type="button" data-preset={preset}>{label}</button>)}
      </div>
      <label class="search" for="q">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input id="q" type="search" aria-label={T.search} autocomplete="off" required /><span class="q-hint" aria-hidden="true">{T.search}</span>
      </label>
      <noscript><p class="sub">{T.noscript}</p></noscript>
      </div>
      <slot name="beside" />
    </section>

    <div class="pk-verdict" id="leaderboard">
      <h2 id="verdict" aria-live="polite">{verdictText(initial, [], T)}</h2>
      <div class="legend" aria-label={T.legendAria}><span><i class="lg-pass"></i>{T.lgPass}</span><span><i class="lg-fail"></i>{T.lgFail}</span><span><i class="lg-held"></i>{T.lgHeld}</span><span><span class="tiny">{T.lgFewTag}</span> {T.lgFew}</span></div>
    </div>
    <div class="caveat" id="caveat" hidden></div>
    <div class="tiebreak"><span>{T.tbLabel}</span>
      <div class="seg" role="group" aria-label={T.sortAria}>
        {sortButtons.map(([tb, label, pressed]) => <button type="button" data-tb={tb} aria-pressed={pressed}>{label}</button>)}
      </div>
    </div>

    <div class="grid" id="grid">
      {initial.tiers.map((t, i) => {
        const sp = splitters(t.rows, [], T);
        return [
          <div class="tier" data-tier={i + 1} id={`tier-${i + 1}`}>
            <div class="tier-line"><span class="tier-no">{tierName(i, T)}</span><span class="tier-title">{tierTitle(t, [], T)}</span></div>
            {sp.length > 0 && <div class="tier-sub"><span>{T.splitHint}</span>{sp.map((id) => <span class="split">+ {LABEL[id]}{small(id) && <span class="tiny">{caseTag(id)}</span>}</span>)}</div>}
          </div>,
          ...t.rows.map(({ lane: l }) => (
            <article class="card glass" data-id={l.id}>
              <div class="card-head"><div class="who"><b>{l.name}</b><small>{l.vendor}</small></div><div class="pk-score"><big>{displayTotal(l)}/{l.n}</big><small>{T.totalScore}</small></div></div>
              <div class="rows">
                {axisIds(T).map((id) => {
                  const c = l.axis[id];
                  return (
                    <div class="axis-row">
                      <span class="lbl">{LABEL[id]}{small(id) && <span class="tiny">{caseTag(id)}</span>}</span>
                      {c.n === 0 ? <span class="none">{T.notSat}</span> : <div class="pips">{pipList(c).map((cls) => <i class={cls}></i>)}</div>}
                      <span class="frac">{c.n === 0 ? '—' : `${c.p}/${c.n}`}</span>
                    </div>
                  );
                })}
              </div>
              {l.e && (
                <div class="effort"><span class="k">{T.perCase}</span><span class="v"><b class="tm">{tr(T, 'median', { t: fmtSec(l.e.t_med, T) })}</b><span class="tbar"><i style={`width:${Math.max(4, Math.round(l.e.t_med / maxMed * 100))}%`}></i></span></span><span class="k">{T.total}</span><span class="v"><small class="tt">{tr(T, 'totalLine', { t: fmtSec(l.e.t_total, T), n: l.e.t_n, tok: fmtTok(l.e.tok, T) })}</small></span></div>
              )}
              <div class="card-foot"><span class="wk">{tr(T, 'week', { wk: l.wk, n: l.cases })}</span><a class="cmp-toggle" href={`https://github.com/getaskclaw/${l.repo}`}>{T.repoLink}</a></div>
            </article>
          )),
        ];
      })}
    </div>
    <p class="out" id="out" hidden></p>
    <slot />
  </div>

  <div class="dock glass" id="dock" aria-live="polite">
    <div class="picked" id="picked"></div>
    <button class="btn ghost" type="button" id="clear-cmp">{T.clear}</button>
    <button class="btn" type="button" id="open-cmp">{T.compare}</button>
  </div>

  <button class="totop glass" type="button" id="totop" aria-label={T.totop}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg></button>

  <dialog class="sheet" id="sheet" aria-labelledby="sheet-title"><div class="sheet-body glass" id="sheet-body"></div></dialog>

  <script is:inline set:html={clientSource}></script>
