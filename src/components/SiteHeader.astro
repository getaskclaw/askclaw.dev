---
import { route } from '../utils/route';

interface Props {
  lang?: string;
  currentPath?: string;
}

const { lang = 'zh-CN', currentPath = '/' } = Astro.props;
const isEnglish = lang === 'en';
const homePath = isEnglish ? '/en/' : '/';
// icon = one inline SVG path (24x24 viewBox, stroke only)
const items = isEnglish
  ? [
      ['matrix', 'Rank by axis', '/en/rank/', 'M4 20V10M10 20V4M16 20v-7M22 20H2'],
      ['method', 'Method (中文)', '/method/', 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7'],
      ['claim', 'Claim consistency', '/en/claim/', 'M5 12l4 4 10-10'],
      ['notes', 'Notes (中文)', '/notes/', 'M4 20l1-4L16 5l3 3L8 19zM14 7l3 3'],
    ]
  : [
      ['matrix', '按轴排行', '/rank/', 'M4 20V10M10 20V4M16 20v-7M22 20H2'],
      ['method', '方法', '/method/', 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7'],
      ['notes', '随笔', '/notes/', 'M4 20l1-4L16 5l3 3L8 19zM14 7l3 3'],
    ];
---
<header class="site-header">
  <input type="checkbox" id="rail-toggle" class="rail-toggle-input" aria-label={isEnglish ? 'Menu' : '菜单'} />
  <div class="rail-bar">
    <a class="logo" href={route(homePath)} aria-label="AskClaw home" aria-current={currentPath === homePath ? 'page' : undefined}>
      <img class="logo-mark" src={route('/assets/crab-chat.webp')} width="40" height="30" alt="" /><span class="logo-text">Ask<span>Claw</span></span>
    </a>
    <label class="rail-button" for="rail-toggle" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </label>
  </div>
  <label class="rail-backdrop" for="rail-toggle" aria-hidden="true"></label>
  <nav class="header-nav" aria-label={isEnglish ? 'Primary navigation' : '主导航'}>
    {items.map(([key, label, path, icon]) => (
      <a href={route(path)} title={label} aria-current={currentPath === path ? 'page' : undefined}>
        <svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg>
        <span class="nav-label">{label}</span>
      </a>
    ))}
    <a
      class="language-toggle"
      href={isEnglish ? route('/') : route('/en/')}
      title={isEnglish ? '切换到中文' : 'Switch to English'}
      aria-label={isEnglish ? '切换到中文' : 'Switch to English'}
    >
      <svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" /></svg>
      <span class="nav-label lang-label"><span class={isEnglish ? undefined : 'language-current'}>中</span><span class="lang-sep" aria-hidden="true">/</span><span class={isEnglish ? 'language-current' : undefined}>EN</span></span>
    </a>
  </nav>
</header>
