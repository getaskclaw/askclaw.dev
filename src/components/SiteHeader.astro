---
import { route } from '../utils/route';

interface Props {
  lang?: string;
  currentPath?: string;
}

const { lang = 'zh-CN', currentPath = '/' } = Astro.props;
const isEnglish = lang === 'en';
const homePath = isEnglish ? '/en/' : '/';
const items = isEnglish
  ? [
      ['home', 'Home', '/en/'],
      ['matrix', 'Axis matrix (中文)', '/rank/'],
      ['repos', 'Results (中文)', '/method/#repos-title'],
      ['method', 'Method (中文)', '/method/#verify-title'],
      ['notes', 'Notes (中文)', '/notes/'],
    ]
  : [
      ['home', '总榜', '/'],
      ['matrix', '九轴矩阵', '/rank/'],
      ['repos', '成绩仓', '/method/#repos-title'],
      ['method', '规范', '/method/#verify-title'],
      ['notes', '随笔', '/notes/'],
    ];
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href={route(homePath)} aria-label="AskClaw home">Ask<span>Claw</span></a>
    <nav class="header-nav" aria-label={isEnglish ? 'Primary navigation' : '主导航'}>
      {items.map(([key, label, path]) => (
        <a href={route(path)} aria-current={currentPath === path ? 'page' : undefined}>{label}</a>
      ))}
      <a
        class="language-toggle"
        href={isEnglish ? route('/') : route('/en/')}
        aria-label={isEnglish ? '切换到中文' : 'Switch to English'}
      >
        <span class={isEnglish ? undefined : 'language-current'}>中</span>
        <span aria-hidden="true">/</span>
        <span class={isEnglish ? 'language-current' : undefined}>EN</span>
      </a>
    </nav>
  </div>
</header>
