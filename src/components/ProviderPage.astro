---
// A provider (endpoint / result repo): every lane the board holds for it, one row per model.
// Only lanes on the board are listed; the result repo may hold earlier lanes the board does not.
import BaseLayout from '../layouts/BaseLayout.astro';
import { I18N } from '../utils/picker-i18n.js';
import DotBoard from './DotBoard.astro';
import { route } from '../utils/route';
import { laneInfo, lanesOfProvider, providerPath } from '../utils/lane-pages';

interface Props { lang: 'zh' | 'en'; slug: string }
const { lang, slug } = Astro.props;
const zh = lang === 'zh';
const T = I18N[lang];
const infos = lanesOfProvider(slug).map((id) => laneInfo(id, lang));
const modelCount = new Set(infos.map((i) => i.page.model_slug)).size;
const sameVendor = new Set(infos.map((i) => i.vendor)).size === 1;
// A repo whose lanes sit on different channels (WorkBuddy ACP and direct) is named by the provider label, not by its first lane's vendor.
const vendor = sameVendor ? infos[0].vendor : ((T as any).providerLabels?.[slug] ?? infos[0].vendor);
const laneNote = infos.length > modelCount;
const repo = infos[0].page.repo;
// same records and display labels as the board; DotBoard sorts by total and links each name to its model page
const boardLanes = infos.map((i) => ({ ...i.lane, name: i.name, vendor: i.vendor }));
const t = zh ? {
  title: `${vendor} 的成绩 — AMBER 琥珀评测`,
  desc: `AMBER 榜单收录的 ${vendor} 车道：${modelCount} 个模型${laneNote ? `、${infos.length} 条车道` : ''}，逐轴点阵，逐个链到成绩页。`,
  back: '← 全部车道', other: 'English version →', kind: '提供方（端点）',
  sub: `榜单收录 ${modelCount} 个模型${laneNote ? `、${infos.length} 条车道` : ''}`,
  note: '一点 = 一案。各行的测试周次可能不同；跨周比较要带上周次。点进模型页看每案结果。',
  scope: '这里只列本站榜单收录的车道；成绩仓里可能还有更早的车道，以成绩仓为准。',
  repo: '本提供方的成绩仓',
} : {
  title: `${vendor} results — AMBER`,
  desc: `AMBER board lanes for ${vendor}: ${modelCount} model${modelCount > 1 ? 's' : ''}${laneNote ? `, ${infos.length} lanes` : ''}, each linking to its result page.`,
  back: '← All lanes', other: 'Chinese version →', kind: 'Provider (endpoint)',
  sub: `${modelCount} model${modelCount > 1 ? 's' : ''}${laneNote ? `, ${infos.length} lanes` : ''} on the board`,
  note: 'One dot = one case. Rows may be tested in different weeks; a cross-week comparison must carry the week. Open a model page for every case.',
  scope: 'Only lanes on this board are listed; the result repo may hold earlier lanes, and the repo is the record.',
  repo: 'Result repo for this provider',
};
const here = providerPath(lang, slug);
const there = providerPath(zh ? 'en' : 'zh', slug);
---
<BaseLayout title={t.title} description={t.desc} lang={zh ? 'zh-CN' : 'en'} canonicalPath={here} schemaInLanguage={zh ? 'zh-CN' : 'en'}>
  <div class="wrap lane-page">
    <p class="note"><a href={route(zh ? '/rank/' : '/en/rank/')}>{t.back}</a> · <a href={route(there)} lang={zh ? 'en' : 'zh-CN'}>{t.other}</a></p>
    <h1>{vendor}</h1>
    <p class="lead">{t.kind} · {t.sub}</p>
    <p class="hint">{t.note}</p>
    <DotBoard lanes={boardLanes} lang={lang} hideVendor={sameVendor} />
    <p class="hint">{t.scope}</p>
    <p class="note"><a href={`https://github.com/getaskclaw/${repo}`} target="_blank" rel="noopener">{t.repo}: {repo}</a></p>
  </div>
</BaseLayout>

<style>
  .lane-page { padding-top: 22px; }
  .lane-page h1 { margin-bottom: 14px; }
</style>
