---
// One model's result page. A model with a single lane shows that lane's record; a model tested on several
// endpoints shows them side by side (never merged), then one full record per endpoint.
import BaseLayout from '../layouts/BaseLayout.astro';
import { I18N } from '../utils/picker-i18n.js';
import { displayTotal, fmtSec, fmtTok } from '../utils/picker-core.js';
import { route } from '../utils/route';
import siteData from '../data/site-data.json';
import { MODEL_NOTE, MODEL_TITLE, PAIR_PAGE, laneInfo, lanesOfModel, lanesOfProvider, modelPath, modelSlugOf, providerHasPage, providerPath } from '../utils/lane-pages';

interface Props { lang: 'zh' | 'en'; slug: string }
const { lang, slug } = Astro.props;
const zh = lang === 'zh';
const T = I18N[lang];

const ids = lanesOfModel(slug);
const infos = ids.map((id) => laneInfo(id, lang));
const multi = infos.length > 1;
const modelName = MODEL_TITLE[slug] ?? (multi ? infos[0].page.model.split('/').pop() : infos[0].name);
const note = MODEL_NOTE[slug];
const axes = siteData.axes;
const axisIndex = Object.fromEntries(axes.map((a, i) => [a.id, i]));
const axisName = (a: string) => { const x = axes.find((y) => y.id === a); return x ? (zh ? x.name_zh : x.name_en) : a; };
const wk = (w: string) => w.replace(/^\d{4}-/, '');
const tokText = (n: number | null) => n == null ? '—' : n < (zh ? 1e4 : 1e5) ? (zh ? '<1 万' : '<0.1M') : fmtTok(n, T);
const blocks = infos.map((i) => {
  const eff = (siteData as any).lanes[i.id];
  // the same model on another endpoint is in the side-by-side table, not an "other model"
  // and a model with several lanes in this provider is listed once, under its plain name
  const sameProvider = lanesOfProvider(i.page.provider_slug).filter((o) => o !== i.id && modelSlugOf(o) !== slug).map((o) => laneInfo(o, lang));
  const others = [...new Set(sameProvider.map((o: any) => o.page.model_slug))].map((ms) => {
    const lanes = sameProvider.filter((o: any) => o.page.model_slug === ms);
    return lanes.length > 1 ? { ...lanes[0], name: lanes[0].page.model.split('/').pop() } : lanes[0];
  });
  return {
    ...i, eff, total: displayTotal(i.lane), others,
    cases: [...i.page.cases].sort((a: any, b: any) => axisIndex[a.axis] - axisIndex[b.axis]),
    fails: i.page.cases.filter((c: any) => c.status === 'fail').length,
    nas: i.page.cases.filter((c: any) => c.status === 'na').length,
    showHistory: !i.page.history_withheld && i.page.history.length > 1,
  };
});
// Two lanes of one model on the same endpoint (gpt-5.6-luna-900k: the W37 "high" lane and the W41 lane) would carry the
// same provider label: such a lane is labelled by its lane name too, in the side-by-side table and above its block.
const dupVendor = (v: string) => blocks.filter((o) => o.vendor === v).length > 1;
blocks.forEach((b: any) => { b.label = dupVendor(b.vendor) ? `${b.vendor} · ${b.name}` : b.vendor; });
const first = blocks[0];
// Exactly two lanes of a pair page: the per-case table is side by side, and the cases where the lanes differ are listed.
const pairOn = Boolean(PAIR_PAGE[slug]) && blocks.length === 2;
const pairRows = pairOn ? blocks[0].cases.map((c: any) => {
  const o = blocks[1].cases.find((d: any) => d.alias === c.alias);
  return { c, o, diff: !o || o.status !== c.status, miss: c.status !== 'pass' || (o ? o.status !== 'pass' : true) };
}) : [];
const t = zh ? {
  title: multi ? `${modelName} 成绩（各端点）— AMBER 琥珀评测` : `${modelName} 成绩 — AMBER 琥珀评测`,
  desc: multi
    ? `${modelName} 在 ${blocks.length} 个端点上的 AMBER 成绩，并排列出，不合并。`
    : `${modelName}（${first.vendor}）在 AMBER 的成绩：总分 ${first.total}/${first.lane.n}，逐轴点阵、各案别名与结果、用时和 token。`,
  back: '← 全部车道', other: 'English version →',
  sub: (b: any) => `测于 ${wk(b.page.week)} · ${b.lane.n} 案`,
  provider: '提供方', moreHere: '同一提供方的其他模型', totalLabel: '总分',
  prime: `′ = 其中有案暂不计分（NA），不算输。`,
  axisH: '逐轴', casesH: '逐案', cAlias: '案别名', cAxis: '轴', cResult: '结果', cTime: '用时', cTok: 'token',
  pass: '通过', fail: '未过', na: 'NA',
  effH: '用时与 token', med: '每题用时（中位）', p90: '最慢 10% 不短于', tokTotal: 'token 合计',
  histH: '考试记录', hWeek: '周次', hTotal: '总分', hShown: '榜上展示', yes: '展示中',
  histNote: '每场考试各考一次；场与场之间的差别不据此判断模型变强或变弱。榜上只展示标记的一场。',
  cmpH: '各端点并排', cmpNote: '同名模型换个端点可能是另一个脑，所以成绩一律按「端点 × 名字」记。下面分别列出，不合并、不比高低；测试周次不同时不可直接比较。',
  cmpWeek: '测试周次', cmpTotal: '总分', cmpMed: '每题用时（中位）',
  tally: (f: number, n: number) => [f ? `未过 ${f}` : '', n ? `NA ${n}` : ''].filter(Boolean).join(' · ') + '（表中浅底色的行）',
  cardLabel: '十轴', statsLabel: '用时与 token',
  recName: '记录名', aliasNote: '官方文档现行写法：模型名 deepseek-flash 即 DeepSeek-V4.1-Flash。本页把用 deepseek-flash 和 deepseek-v4.1-flash 这两个名字考的车道放在一起；各端点的成绩仍分别记录，不合并、不互比。', aliasSrc: 'DeepSeek 官方定价页',
  repo: '成绩仓', secret: '题目永不公开，每案只给 A- 别名。NA = 作废或挂起，不计输赢。',
  pairCasesH: '逐案对照（两道并排）', pairDivH: '两道结果不同的案', pairDivNote: '只有下列案在两道上结果不同；两道结果相同的案只在下方完整表里看。',
  pairTest: (band: string, week: string, n: number) => `测试条件：${band} 档 · 模型名含 free · 测于 ${week} · ${n} 案`,
  onlyDiff: '只看分歧', onlyFail: '只看未过或 NA', correction: '更正声明', timeCap: '撞考场时间上限',
  naR: { held: '全车道挂起', infra: '考场基建作废', integrity: '作答越界作废', legacy: '裁定作废', contested: '待重评' },
} : {
  title: multi ? `${modelName} results by endpoint — AMBER` : `${modelName} results — AMBER`,
  desc: multi
    ? `AMBER results for ${modelName} on ${blocks.length} endpoints, side by side and never merged.`
    : `AMBER results for ${modelName} (${first.vendor}): total ${first.total}/${first.lane.n}, axis-by-axis dots, per-case aliases and outcomes, time and tokens.`,
  back: '← All lanes', other: 'Chinese version →',
  sub: (b: any) => `tested ${wk(b.page.week)} · ${b.lane.n} cases`,
  provider: 'Provider', moreHere: 'Other models from this provider', totalLabel: 'Total',
  prime: `′ = at least one case is NA (not scored; it does not count as a loss).`,
  axisH: 'By axis', casesH: 'Case by case', cAlias: 'Case alias', cAxis: 'Axis', cResult: 'Result', cTime: 'Time', cTok: 'Tokens',
  pass: 'Pass', fail: 'Fail', na: 'NA',
  effH: 'Time and tokens', med: 'Median time per case', p90: 'Slowest 10% at least', tokTotal: 'Tokens in all',
  histH: 'Sittings', hWeek: 'Week', hTotal: 'Total', hShown: 'On the board', yes: 'shown',
  histNote: 'Each sitting was taken once; a difference between sittings is not evidence that the model got stronger or weaker. The board shows the marked sitting only.',
  cmpH: 'Endpoints side by side', cmpNote: 'The same model name on a different endpoint can be a different brain, so scores are recorded per endpoint × name. Listed separately below: not merged, not ranked against each other, and not comparable when the tested weeks differ.',
  cmpWeek: 'Tested', cmpTotal: 'Total', cmpMed: 'Median time per case',
  tally: (f: number, n: number) => [f ? `${f} failed` : '', n ? `${n} NA` : ''].filter(Boolean).join(' · ') + ' (shaded rows below)',
  cardLabel: 'By axis', statsLabel: 'Time and tokens',
  recName: 'Recorded as', aliasNote: 'DeepSeek\'s documentation now says the model name deepseek-flash is DeepSeek-V4.1-Flash. This page puts the lanes sat under deepseek-flash and deepseek-v4.1-flash together; each endpoint keeps its own record, not merged and not ranked against the others.', aliasSrc: 'DeepSeek pricing page',
  repo: 'Result repo', secret: 'Cases are never published; each case is shown by its A- alias. NA = voided or held; neither a win nor a loss.',
  pairCasesH: 'Case by case (two lanes side by side)', pairDivH: 'Cases where the two lanes differ', pairDivNote: 'Only these cases give different results on the two lanes; the cases the lanes share are in the full table below.',
  pairTest: (band: string, week: string, n: number) => `Test conditions: ${band} band · free model build · tested ${week} · ${n} cases`,
  onlyDiff: 'Only differences', onlyFail: 'Only failed or NA', correction: 'correction notice', timeCap: 'hit the exam-room time cap',
  naR: { held: 'held on every lane', infra: 'voided for infrastructure', integrity: 'voided for integrity', legacy: 'voided by ruling', contested: 'contested' },
};
const here = modelPath(lang, slug);
const there = modelPath(zh ? 'en' : 'zh', slug);
const rankPath = zh ? '/rank/' : '/en/rank/';
const H = multi ? 'h3' : 'h2';
const groups = siteData.groups.map((g: any) => ({ id: g.id, label: zh ? g.name_zh : g.name_en, axes: axes.filter((a: any) => a.grp === g.id) }));
// One writing for a cell's visible text and its aria-label: passes over the axis's cases (the denominator is fixed,
// as in the generated tables), the NA count named beside it, and a wholly held axis reads NA (never as a fail).
const cellText = (c: any) => !c || c.n === 0 ? '—' : c.na === c.n ? 'NA' : `${c.p}/${c.n}` + (c.na ? ` · NA ${c.na}` : '');
// NA rows say why they are not counted; held cases link to their correction notice.
const CORRECTION: Record<string, string> = { 'A-d511f9e8': 'corrections-2026-10-02-a-d511f9e8', 'A-cdc3d11a': 'corrections-2026-10-07-a-cdc3d11a', 'A-24bcf707': 'corrections-2026-10-07-a-24bcf707' };
const correctionHref = (alias: string) => CORRECTION[alias] ? `https://github.com/getaskclaw/amber/blob/main/docs/${CORRECTION[alias]}${zh ? '.md' : '.en.md'}` : undefined;
const naLabel = (c: any) => {
  if (c.status !== 'na') return t[c.status];
  const why = c.na_reason === 'infra' && c.wall_s >= 1800 ? t.timeCap : (t.naR as any)[c.na_reason];
  return why ? `NA · ${why}` : 'NA';
};
const dots = (cell: any) => cell && cell.n > 0 ? [
  ...Array(cell.p).fill('pass'),
  ...Array(cell.n - cell.p - (cell.na ?? 0)).fill('fail'),
  ...Array(cell.na ?? 0).fill('na'),
] : null;
---
<BaseLayout title={t.title} description={t.desc} lang={zh ? 'zh-CN' : 'en'} canonicalPath={here} schemaInLanguage={zh ? 'zh-CN' : 'en'}>
  <div class="wrap lane-page">
    <p class="note"><a href={route(rankPath)}>{t.back}</a> · <a href={route(there)} lang={zh ? 'en' : 'zh-CN'} data-lang-switch={zh ? 'en' : 'zh-CN'}>{t.other}</a></p>
    <h1>{pairOn ? PAIR_PAGE[slug].h1[lang] : modelName}</h1>

    {note && <p class="hint alias-note">{t.aliasNote} <a href={note.href} target="_blank" rel="noopener">{t.aliasSrc}</a></p>}

    {multi && (
      <section class="section" aria-labelledby="cmp-h">
        <h2 id="cmp-h">{t.cmpH}</h2>
        <p class="hint">{t.cmpNote}</p>
        <div class="board-wrap">
          <table class="board">
            <thead><tr><th>{t.provider}</th><th class="num">{t.cmpTotal}</th><th>{t.cmpWeek}</th><th class="num">{t.cmpMed}</th></tr></thead>
            <tbody>
              {blocks.map((b) => (
                <tr>
                  <td><a href={`#lane-${b.id}`}>{b.label}</a></td>
                  <td class="num">{b.total}/{b.lane.n}</td>
                  <td>{wk(b.page.week)}</td>
                  <td class="num">{b.eff ? fmtSec(b.eff.t_med, T) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {pairOn && (
      <section class="section pair" id="pair-cases">
        <h2>{t.pairCasesH}</h2>
        <p class="hint">{t.pairTest(first.page.band, wk(first.page.week), first.lane.n)}</p>
        {pairRows.some((r: any) => r.diff) && (
          <div class="diverge">
            <h3>{t.pairDivH} · {pairRows.filter((r: any) => r.diff).length}</h3>
            <p class="hint">{t.pairDivNote}</p>
            <ul class="diverge-list">
              {pairRows.filter((r: any) => r.diff).map((r: any) => (
                <li><code>{r.c.alias}</code> · {axisName(r.c.axis)} · <strong>{blocks[0].label}</strong>: {naLabel(r.c)} · <strong>{blocks[1].label}</strong>: {r.o ? naLabel(r.o) : '—'}</li>
              ))}
            </ul>
          </div>
        )}
        <input type="checkbox" id="pair-only-diff" class="pair-toggle pair-toggle-diff" />
        <input type="checkbox" id="pair-only-fail" class="pair-toggle pair-toggle-fail" />
        <div class="pair-filter">
          <label for="pair-only-diff">{t.onlyDiff}</label>
          <label for="pair-only-fail">{t.onlyFail}</label>
        </div>
        <div class="pair-wrap board-wrap">
          <table class="board pair-table">
            <thead>
              <tr><th rowspan="2">{t.cAlias}</th><th rowspan="2" class="axis-col">{t.cAxis}</th>{blocks.map((b: any) => <th colspan="3">{b.label}</th>)}</tr>
              <tr>{blocks.map(() => (<Fragment><th>{t.cResult}</th><th class="num">{t.cTime}</th><th class="num">{t.cTok}</th></Fragment>))}</tr>
            </thead>
            <tbody>
              {pairRows.map((r: any) => (
                <tr data-diff={r.diff ? '1' : '0'} data-fail={r.miss ? '1' : '0'}>
                  <td><code>{r.c.alias}</code></td>
                  <td class="axis-col">{axisName(r.c.axis)}</td>
                  {[r.c, r.o].map((c: any) => (
                    <Fragment>
                      <td><span class="res"><i class={`dot ${c ? c.status : 'na'}`}></i>{c ? naLabel(c) : '—'}{c && c.status === 'na' && correctionHref(c.alias) && <Fragment> · <a href={correctionHref(c.alias)} target="_blank" rel="noopener">{t.correction}</a></Fragment>}</span></td>
                      <td class="num">{c && c.wall_s != null ? fmtSec(c.wall_s, T) : '—'}</td>
                      <td class="num">{c ? tokText(c.tokens) : '—'}</td>
                    </Fragment>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {blocks.map((b) => (
      <div class="lane-block" id={`lane-${b.id}`}>
        {multi && <h2>{b.label}</h2>}
        <p class="lead">
          {t.provider}: {providerHasPage(b.page.provider_slug) ? <a href={route(providerPath(lang, b.page.provider_slug))}>{b.vendor}</a> : b.vendor} · {t.sub(b)}{multi && b.record !== modelName && <Fragment> · {t.recName}: <code>{b.record}</code></Fragment>}
        </p>
        {b.others.length > 0 && (
          <p class="note">{t.moreHere}: {b.others.map((o: any, i: number) => (<Fragment>{i > 0 ? ' · ' : ''}<a href={route(modelPath(lang, o.page.model_slug))}>{o.name}</a></Fragment>))}</p>
        )}

        <div class="lane-grid">
          <aside class="summary" aria-label={multi ? `${t.cardLabel} · ${b.label}` : t.cardLabel}>
            <p class="lane-total"><span class="lane-total-label">{t.totalLabel}</span> <strong>{b.total}</strong><span class="lane-total-n">/{b.lane.n}</span></p>
            <p class="card-note">{t.prime}</p>
            <div class="axes-wrap">
            {groups.map((g: any) => (
              <div class="agroup">
                <p class="card-label">{g.label}</p>
                <ul class="axis-list">
                  {g.axes.map((a: any) => {
                    const cell = b.lane.axis[a.id]; const d = dots(cell);
                    return (
                      <li>
                        <span class="axis-name">{zh ? a.name_zh : a.name_en}</span>
                        {d ? (<Fragment><span class="dots" role="img" aria-label={cellText(cell)}>{d.map((st) => <i class={`dot ${st}`}></i>)}</span><span class="axis-txt" aria-hidden="true">{cellText(cell)}</span></Fragment>) : <span class="dot-none">—</span>}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
            </div>
            <div class="agroup">
              <p class="card-label">{t.statsLabel}</p>
              {b.eff ? (
                <dl class="stats">
                  <div><dt>{t.med}</dt><dd>{fmtSec(b.eff.t_med, T)}</dd></div>
                  <div><dt>{t.p90}</dt><dd>{fmtSec(b.eff.t_p90, T)}</dd></div>
                  <div><dt>{t.tokTotal}</dt><dd>{b.eff.tok ? fmtTok(b.eff.tok, T) : T.tokNone}</dd></div>
                </dl>
              ) : <p class="card-note">—</p>}
            </div>
          </aside>

          <div class="evidence">
            <H class="ev-title" id={`cases-${b.id}`}>{t.casesH}</H>
            <p class="hint">{t.secret}</p>
            {(b.fails > 0 || b.nas > 0) && <p class="tally">{t.tally(b.fails, b.nas)}</p>}
            {!pairOn && (
            <div class="board-wrap">
              <table class="board">
                <thead><tr><th>{t.cAlias}</th><th class="axis-col">{t.cAxis}</th><th>{t.cResult}</th><th class="num">{t.cTime}</th><th class="num">{t.cTok}</th></tr></thead>
                <tbody>
                  {b.cases.map((c: any) => (
                    <tr class={`row-${c.status}`}>
                      <td><code>{c.alias}</code></td>
                      <td class="axis-col">{axisName(c.axis)}</td>
                      <td><span class="res"><i class={`dot ${c.status}`}></i>{naLabel(c)}{c.status === 'na' && correctionHref(c.alias) && <Fragment> · <a href={correctionHref(c.alias)} target="_blank" rel="noopener">{t.correction}</a></Fragment>}</span></td>
                      <td class="num">{c.wall_s == null ? '—' : fmtSec(c.wall_s, T)}</td>
                      <td class="num">{tokText(c.tokens)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            )}

            {b.showHistory && (
              <div class="history">
                <H class="ev-title" id={`hist-${b.id}`}>{t.histH}</H>
                <p class="hint">{t.histNote}</p>
                <div class="board-wrap">
                  <table class="board">
                    <thead><tr><th>{t.hWeek}</th><th class="num">{t.hTotal}</th><th>{t.hShown}</th></tr></thead>
                    <tbody>
                      {b.page.history.map((h: any) => (
                        <tr>
                          <td>{h.week}</td>
                          <td class="num">{h.total}{h.na > 0 ? "\u2032" : ''}/{h.n}</td>
                          <td>{h.current ? t.yes : ''}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
            <p class="note"><a href={`https://github.com/getaskclaw/${b.page.repo}`} target="_blank" rel="noopener">{t.repo}: {b.page.repo}</a></p>
          </div>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .lane-page { padding-top: 22px; }
  .lane-page h1 { margin-bottom: 14px; }
  .lane-page .section { padding: 22px 0 0; }
  .lane-block + .lane-block { margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--line); }
  .lane-block .lead { margin: 0 0 6px; }
  .lane-block > .note { margin: 0 0 14px; }
  .lane-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 32px; align-items: start; margin-top: 18px; }
  .summary {
    position: sticky; top: 24px;
    padding: 18px 18px 16px; border: 1px solid var(--line); border-radius: 18px;
    background: rgba(255, 255, 255, .55);
  }
  .lane-total { display: flex; align-items: baseline; gap: 8px; margin: 0; }
  .lane-total strong { font-size: 2.8rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .lane-total-label, .lane-total-n { color: var(--sub); }
  .card-note { margin: 4px 0 0; font-size: 0.8rem; color: var(--sub); }
  .agroup { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); }
  .card-label { margin: 0 0 6px; font-size: 0.74rem; letter-spacing: .06em; color: var(--sub); }
  .axis-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; }
  .axis-list li { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 4px 0; font-size: 0.92rem; }
  .stats { margin: 0; display: grid; gap: 6px; }
  .stats div { display: flex; justify-content: space-between; gap: 12px; font-size: 0.88rem; }
  .stats dt { color: var(--sub); }
  .stats dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
  .evidence { min-width: 0; }
  .ev-title { margin: 0 0 6px; font-size: 1.25rem; }
  .history { margin-top: 28px; }
  .tally { margin: 0 0 10px; font-weight: 600; font-size: 0.92rem; }
  .row-fail td { background: rgba(214, 72, 40, .09); }
  .row-na td { background: rgba(120, 132, 146, .13); }
  .dots { display: inline-flex; gap: 2px; }
  .dot { display: inline-block; box-sizing: border-box; width: 11px; height: 11px; border-radius: 50%; border: 2px solid var(--amber-deep, #a85a00); background: var(--amber, #e08a12); }
  .dot.fail { background: transparent; border-color: rgba(23, 32, 43, .5); }
  .dot.na { background: #aeb6bf; border-color: #aeb6bf; }
  .dot-none { color: var(--sub); }
  .res { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .axis-txt { margin-left: 10px; color: var(--sub); font-size: 0.86rem; font-variant-numeric: tabular-nums; }
  .pair-toggle { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; }
  .pair-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 10px; }
  .pair-filter label { cursor: pointer; padding: 4px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 0.86rem; background: rgba(255,255,255,.6); }
