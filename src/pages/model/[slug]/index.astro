---
// Old address of a model page: the page now lives at /<name>/ (see src/utils/lane-pages.ts).
import Redirect from '../../../components/Redirect.astro';
import { rawModelSlugs, modelPath } from '../../../utils/lane-pages';
export function getStaticPaths() {
  return rawModelSlugs().map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
---
<Redirect to={modelPath('zh', slug)} />
