---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { route } from '../../../utils/route';
import siteData from '../../../data/site-data.json';
import axesLanes from '../../../data/axes.json';

// The newest tested week on the board (was typed in by hand and went stale: it still said W39 after W40).
const latestWeek = axesLanes.map((lane) => lane.wk).sort().at(-1);

// Axes and groups as published (amber.db axes.sql): the text below never hard-codes their number.
const axisById = Object.fromEntries(siteData.axes.map((a) => [a.id, a]));
const axisNote = (id) => `「${axisById[id].name_zh}」（${axisById[id].hint_zh}）`;
const groupsText = siteData.groups.map((g) => `${g.name_zh}：${siteData.axes.filter((a) => a.grp === g.id).map((a) => a.name_zh).join('、')}`);

const resultRepos = [
  ['amber-devin', "19'/24", 'swe-2-max @ Devin', 'W37'],
  ['amber-kimi', "18'/24", 'k3 @ Kimi 官方 coding', 'W38'],
  ['amber-ollama', "18'/24", 'glm-5.3-flash / d41f @ Ollama Cloud', 'W37'],
  ['amber-commandcode', "15'/23 ∅", 'd41f @ CommandCode · owner 令冻结', 'W37'],
  ['amber-workbuddy', "18'/24", "deepseek-v4.1-flash 18'/24（W40）· glm-5.3-flash 17'/24（W40）· hy4-preview-f 16'/24（W40）· minimax-m3 16'/24（W40）@ WorkBuddy 直连 · hy4-preview-f 18'/24（W37）@ WorkBuddy ACP", 'W40'],
  ['amber-gpt', "17'/24", "gpt-5.6-luna 17'/24（W41）· gpt-5.6-luna-900k 16'/24（W41）· gpt-6-luna 16'/24（W41）· gpt-6-luna-900k 15'/24（W41）· gpt-6-astra 16'/24 · 5.6-luna-900k high 16'/24（W37）· 5.6-sol high 15'/23 ∅ · 6.1-sol 16'/24 @ OpenAI Codex", 'W41'],
  ['amber-crof', "16'/23 ∅", 'qwen3.8-27b @ CrofAI · 道停用冻结', 'W37'],
  ['amber-deepseek', "16'/24", 'deepseek-flash @ DeepSeek official', 'W37'],
  ['amber-opencode', "15'/24", 'deepseek-flash @ OpenCode Go', 'W37'],
  ['amber-doubao', "17'/24", 'doubao-seed-evolving @ Volcengine Ark Agent Plan', 'W38'],
  ['amber-stepfun', "18'/24", 'step-5-preview @ stepfun plan 端点（W41 重考，隔离考场；品牌案题面修订后单案重考）', 'W41'],
  ['amber-claude', "19'/24", "claude-sonnet-5-5 19'/24（W40，除 A-d511f9e8 外零 NA）· claude-opus-5-5 19'/24（W40 重考，W39 为 17'/24）· claude-fable-5-1 16'/24 @ Anthropic 订阅道", 'W40'],
  ['amber-goldenpotato', "15'/24", 'Qwen3.8-27B @ community self-hosted', 'W38'],
  ['amber-nous', "16'/24", 'claude-haiku-5.5 @ Nous Portal', 'W41'],
];
---
<BaseLayout
  lang="zh-CN"
  title="方法 — AMBER 琥珀评测"
  description={`AMBER 琥珀评测方法：24 案、27 卷、14 个成绩仓、${latestWeek} 快照和公开哈希索引。`}
  canonicalPath="/zh/method/"
>
  <div class="wrap">
    <section class="hero">
      <h1><em>AMBER</em> 方法</h1>
      <p class="lead">
        琥珀评测把真实、可审计的历史事件封存到答案揭晓前，让模型只用当时可得的信息重做一次。
        评分规则先冻结，题库不公开，分数和校验材料公开。
      </p>
      <div class="stat-grid" aria-label="AMBER facts">
        <div class="stat-card"><strong>24 / 27</strong><span>案 / 卷，私有题库</span></div>
        <div class="stat-card"><strong>14</strong><span>公开成绩仓</span></div>
        <div class="stat-card"><strong>{latestWeek}</strong><span>保留的最新快照</span></div>
      </div>
    </section>

    <section class="section" aria-labelledby="rules-title">
      <h2 id="rules-title">方法原则</h2>
      <p class="hint">公开材料可以复核成绩，但不会泄露私有题库。</p>
      <div class="rule-list">
        <div class="rule">私有内容：题库、oracle、transcript、内部案号和变体名不公开。</div>
        <div class="rule">公开内容：成绩、汇总、裁决和哈希索引，任何人都可以重新核对。</div>
        <div class="rule">历史结果是证据，不是唯一正解；运行时封存也不等于训练数据纯净。</div>
        <div class="rule">考场条件变更逐条公开。2026-10-01 起，hermes 道的系统提示只保留净室内容，之前各期条件一致、成绩不改；见 <a href="https://github.com/getaskclaw/amber/blob/main/docs/method-change-2026-10-01.md">方法变更 2026-10-01</a>。</div>
        <div class="rule">成绩更正也逐条公开。2026-10-02：9 张考卷作答时越出考卷、接触了判分材料，改记 NA，6 条车道总分下调；见 <a href="https://github.com/getaskclaw/amber/blob/main/docs/corrections-2026-10-02.md">更正声明 2026-10-02</a>。</div>
      </div>
    </section>

    <section class="section" aria-labelledby="repos-title">
      <h2 id="repos-title">14 个成绩仓</h2>
      <p class="hint">每个仓对应一条模型结果记录；名称、分数、期号和链接沿用公开材料。</p>
      <p class="note">
        2026-09-21 起题库升到 24 案：收敛轴首案 A-3f2a9cdd 并入 headline，榜单口径从 /23 换到 /24。
        k3 / glm-5.3-flash / v4.1-flash @ Ollama / hy4 四家补测后为 18/24；CommandCode 与 CrofAI
        两道按 owner 令冻结，保留旧口径 17/23、16/23 并标 ∅，不参与 /24 换算（CommandCode 经 2026-10-02 更正为 15'/23）。
        历史沿革（史实，不改）：Ollama 的 glm-5.3-flash 与 CrofAI 的 qwen3.8-27b 曾用 W37 补考合成成绩——
        W36 的 15/21、14/21 各加两案，成为 17/23、16/23。
        <a href={route('/zh/rank/')}>按轴榜</a>保留各行原始期号与案数（含两条 W36 的 21 案记录），不是合成总分。
        口径更正见{' '}
        <a href="https://github.com/getaskclaw/amber/blob/main/docs/corrections-2026-09-21.md">2026-09-21 更正</a>。
      </p>
      <p class="note score-legend">' = contested（安全拒答挂起）、invalid（基建相关（考场 harness 或判分环境）的挂起、作废或待重评）或 integrity（作答时越出考卷、接触判分材料，作废；见 2026-10-02 更正），均不计胜负；所有含 NA 的道都带撇号，包括冻结展示行；挂起不表示死因已定。2026-10-02 起防御案 A-d511f9e8 在所有车道上记 NA（见<a href="https://github.com/getaskclaw/amber/blob/main/docs/corrections-2026-10-02-a-d511f9e8.md">更正声明</a>），每条道的总分都带撇号，过案数不变。Devin 19'/24（2 NA）；Doubao 17'/24（3 NA）；gpt-sol 冻结展示为 15'/23∅（4 NA），不改成 /24。</p>
      <div class="repo-grid">
        {resultRepos.map(([repo, score, model, week]) => (
          <a class="repo-card" href={`https://github.com/getaskclaw/${repo}`}>
            <span class="score">{score}</span>
            <strong>{repo}</strong>
            <small>{model}</small>
            <small>{week} · {score.endsWith('∅') ? '23' : '24'} cases</small>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="axes-title">
      <h2 id="axes-title">按轴看成绩</h2>
      <p class="hint">每道题归入一个轴，轴再分成两个大类。轴的定义随成绩库一起发布，整站按同一份定义显示。</p>
      <div class="panel">
        {groupsText.map((line) => <p>{line}</p>)}
        <p>2026-10-01 起，原「核验」拆成{axisNote('defense')}和{axisNote('attribution')}两个轴，轴名与规范仓的十轴说法统一。各模型总分不变，只是这三题分开记。</p>
        <p><a href={route('/zh/rank/')}>查看按轴排行</a></p>
      </div>
    </section>

    <section class="section" aria-labelledby="claim-title">
      <h2 id="claim-title">完成声明也要能对上验收</h2>
      <p class="hint">AMBER 还统计跑案记录里的完成声明，和独立验收是否一致。</p>
      <div class="panel">
        <p><a href={route('/zh/claim/')}>看 W38 完成声明一致性</a>：验证弱 82 条，纪律缺失 53 条。</p>
      </div>
    </section>

    <section class="section" aria-labelledby="verify-title">
      <h2 id="verify-title">公开校验入口</h2>
      <p class="hint">这些链接是方法和公开记录的原始入口。</p>
      <div class="panel">
        <p><a href="https://github.com/getaskclaw/amber/blob/main/AMBER-Core-Specification.md">AMBER Core Specification</a></p>
        <p><a href="https://github.com/getaskclaw/amber/blob/main/hash-index/v2026-09.md">public hash index</a></p>
        <p><a href="https://github.com/getaskclaw/amber/blob/main/PLAN.md">AMBER roadmap</a></p>
      </div>
    </section>
  </div>
</BaseLayout>
