---
// Old address of a provider page: a provider with several lanes keeps a page at /<name>/; one with a single
// lane leads to its model page.
import Redirect from '../../../../components/Redirect.astro';
import { providerSlugs, providerPath } from '../../../../utils/lane-pages';
export function getStaticPaths() {
  return providerSlugs().map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
---
<Redirect to={providerPath('zh', slug)} />
