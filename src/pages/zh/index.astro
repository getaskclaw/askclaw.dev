---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picker from '../../components/Picker.astro';
import rawAxes from '../../data/axes.json';
import { route } from '../../utils/route';


// Facts in the ask card come from the generated board, not typed in.
const caseCount = Math.max(...rawAxes.map((lane) => lane.n));
const repoCount = new Set(rawAxes.map((lane) => lane.repo)).size;
const latestWeek = rawAxes.map((lane) => lane.wk).sort().at(-1);

const questions = [
  {
    code: 'A',
    tone: 'teal',
    question: '同一个模型，官方端点和第三方有差吗？',
    preview: '同模型，分 lane 对照。',
    cue: '看 lane',
    href: route('/zh/method/#repos-title'),
    ariaLabel: '同一个模型，官方端点和第三方有差吗？同模型，分 lane 对照。查看成绩仓。',
  },
  {
    code: 'B',
    tone: 'amber',
    question: '新出的模型能不能打？',
    preview: `同一套 ${caseCount} 案，进榜即见。`,
    cue: `看 ${latestWeek}`,
    href: route('/zh/#leaderboard'),
    ariaLabel: `新出的模型能不能打？同一套 ${caseCount} 案，进榜即见。查看本页的分档总榜。`,
  },
  {
    code: 'C',
    tone: 'cobalt',
    question: '想逐格看矩阵？',
    preview: '按轴排行，逐格对比。',
    cue: '按轴排',
    href: route('/zh/rank/'),
    ariaLabel: '想逐格看矩阵？按轴排行，逐格对比。查看按轴排行。',
  },
  {
    code: 'D',
    tone: 'gold',
    question: '这榜自己可信吗？',
    preview: '封存、净室、hash 可查。',
    cue: '看规范',
    href: route('/zh/method/#verify-title'),
    ariaLabel: '这榜自己可信吗？封存、净室、hash 可查。查看规范和证据链。',
  },
] as const;
---
<BaseLayout
  lang="zh-CN"
  title="AskClaw — 琥珀评测 AMBER：封存回放式 AI 基准测试"
  description="琥珀评测 AMBER：把真实历史事件封进琥珀，让 AI 只用当时可得的信息重做一次。按你要做的工作挑模型，成绩相同的归入同一梯队，并给出每题用时与 token。"
  canonicalPath="/zh/"
  keywords="琥珀评测, 琥珀, AMBER, AI评测, 大模型评测, LLM评测, 模型排行榜, AI基准测试, AskClaw"
  schemaType="WebSite"
  schemaName="AskClaw"
  schemaAlternateName={['琥珀评测', 'AMBER Benchmark', 'AMBER 琥珀评测']}
  schemaInLanguage={['zh-CN', 'en']}
  pageClass="picker-page"
>
  <Picker>
    <div class="crab-guide" role="group" aria-label="首屏导览" slot="beside">
      <div class="fact-rail" aria-label="AMBER 当前事实">
        <span class="fact-dot" aria-hidden="true"></span>
        <span>{caseCount} 案 · {repoCount} 个成绩仓 · 2026-{latestWeek}</span>
      </div>
    </div>

    <section class="home-more glass" aria-labelledby="more-title">
      <h2 id="more-title">也可以先问这些</h2>
      <div class="question-grid" aria-label="四个公开数据入口">
        {questions.map((entry) => (
          <a class={`question-entry question-entry-${entry.tone}`} href={entry.href} aria-label={entry.ariaLabel}>
            <span class="question-meta"><span class="question-dot" aria-hidden="true"></span><span>{entry.code}</span></span>
            <span class="question-copy"><span class="question">{entry.question}</span><span class="preview">{entry.preview}</span></span>
            <span class="edge-cue"><span class="cue-mark" aria-hidden="true">{entry.code === 'D' ? '#' : '•'}</span>{entry.cue}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pending-section glass" aria-labelledby="pending-title">
      <header class="pending-header">
        <h2 id="pending-title">在补什么</h2>
        <p>先补齐证据，再回到首屏。</p>
      </header>
      <div class="pending-list">
        <div class="pending-row pending-row-e">
          <span class="pending-letter" aria-hidden="true">E</span>
          <div>
            <h3>AI 模型降智了吗？</h3>
            <p>跨家复测还未齐，暂不声称能力回退。</p>
          </div>
          <span class="pending-status">数据待发布</span>
        </div>
        <div class="pending-row pending-row-f">
          <span class="pending-letter" aria-hidden="true">F</span>
          <div>
            <h3>在我关注的方面，有更好的平替吗？</h3>
            <p>便宜候选需要成体系的价格 / 成本源；用时和 token 已在卡片上。</p>
          </div>
          <span class="pending-status">价格待发布</span>
        </div>
      </div>
      <p class="pending-note">次级区只记缺口，不替数据提前下结论。</p>
    </section>
  </Picker>
</BaseLayout>
