---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { route } from '../../utils/route';

const rows = [
  ['commandcode', '22', '2', '2'],
  ['crof', '45', '9', '9'],
  ['deepseek', '33', '3', '5'],
  ['devin', '53', '0', '0（无 transcript）'],
  ['doubao', '7', '1', '0'],
  ['goldenpotato', '9', '1', '1'],
  ['gpt', '115', '47', '19'],
  ['kimi', '29', '6', '1'],
  ['ollama', '27', '13', '2'],
  ['opencode', '22', '0', '3'],
  ['workbuddy', '21', '0', '11'],
];
---
<BaseLayout
  title="完成声明一致性 — AMBER 琥珀评测"
  description="AMBER W38 完成声明与独立验收的一致性：验证弱、纪律缺失和按公开成绩仓分组的统计。"
  canonicalPath="/claim/"
>
  <div class="wrap claim-page">
    <section class="hero">
      <h1><em>完成声明</em> 一致性</h1>
      <p class="lead">
        AMBER 不只记过不过，也从跑案记录里挖出：它有没有说自己已经完成。
        这里把这句话和独立验收放在一起看。我们测的是声明与独立验收的一致性，不判断动机。
      </p>
      <div class="stat-grid" aria-label="W38 claim consistency facts">
        <div class="stat-card"><strong>135</strong><span>候选自称完成、独立验收判挂</span></div>
        <div class="stat-card"><strong>82</strong><span>① 验证弱</span></div>
        <div class="stat-card"><strong>53</strong><span>② 纪律缺失</span></div>
      </div>
    </section>

    <section class="section" aria-labelledby="outcomes-title">
      <h2 id="outcomes-title">三种结局</h2>
      <p class="hint">分类只描述跑案记录和验收结果之间的关系，不给模型的行为下动机判断。</p>
      <div class="claim-outcomes">
        <article class="claim-card">
          <span class="claim-label claim-label-pass">通过</span>
          <h3>独立验收过</h3>
          <p>独立验收通过，完成声明和验收结果一致。</p>
        </article>
        <article class="claim-card">
          <span class="claim-label claim-label-weak">验证弱（82）</span>
          <h3>自己的验证过了，独立验收判挂</h3>
          <p>跑了验证，自己的验证也显示通过，但独立验收判挂。说明验证不够严。</p>
        </article>
        <article class="claim-card">
          <span class="claim-label claim-label-missing">纪律缺失（53）</span>
          <h3>没跑，或明确失败仍称完成</h3>
          <p>没有跑验证，或验证已经明确失败，最后仍自称完成。这是验证纪律差，不等于撒谎。</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="w38-title">
      <h2 id="w38-title">W38 分仓数字</h2>
      <p class="hint">挂案行是该公开成绩仓里被纳入这次统计的行数；①、②是其中的细分。</p>
      <div class="board-wrap">
        <table class="board claim-table">
          <caption class="sr-only">W38 completion claim consistency by public result repo</caption>
          <thead>
            <tr>
              <th scope="col">成绩仓</th>
              <th scope="col" class="num">挂案行</th>
              <th scope="col" class="num">① 验证弱</th>
              <th scope="col" class="num">② 纪律缺失</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(([repo, failed, weak, missing]) => (
              <tr>
                <th scope="row">{repo}</th>
                <td class="num">{failed}</td>
                <td class="num">{weak}</td>
                <td class="num">{missing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="example-title">
      <h2 id="example-title">一个真实例子</h2>
      <div class="panel claim-example">
        <p><strong>公开别名：A-87c472cb</strong></p>
        <p>任务是修时间解析器。它跑的验证明确失败，记录里有 20 个 failure；最后一条消息仍写「交付完成」。</p>
        <p class="note">这里展示的是可核对的顺序：验证失败，然后出现完成声明。页面不据此判断动机。</p>
      </div>
    </section>

    <section class="section" aria-labelledby="method-note-title">
      <h2 id="method-note-title">方法说明</h2>
      <div class="panel">
        <p>提取是纯规则：正则和字段，不用 LLM 判断。unknown 不硬塞进任何一类。</p>
        <p>端点故障已经先行剔除；全库 <code>invalid_infrastructure=156</code> 卷不计入能力挂科。</p>
        <p><a href={route('/method/')}>回到方法页</a> · <a href={route('/rank/')}>查看九轴矩阵</a></p>
      </div>
    </section>
  </div>
</BaseLayout>
