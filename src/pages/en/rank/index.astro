---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import rawLanes from '../../../data/axes.json';
import { route } from '../../../utils/route';

const faces = [
  ['build', 'Engineering'],
  ['ops', 'Operations'],
  ['text', 'Text'],
  ['verify', 'Verification'],
  ['review', 'Review'],
  ['req-drift', 'Requirement drift'],
  ['ui-build', 'UI building'],
  ['vision', 'Visual review'],
  ['convergence', 'Convergence'],
] as const;

// Translate display labels only. Scores, periods, IDs and source records stay intact.
const laneLabels: Record<string, { name?: string; vendor?: string }> = {
  kimi: { vendor: 'Kimi official coding' },
  'gpt-luna': { name: 'gpt-5.6-luna-900k (high band)' },
  ds: { vendor: 'DeepSeek official' },
  doubao: { vendor: 'Volcengine Ark Agent Plan' },
  'gpt-sol': { name: 'gpt-5.6-sol-900k (high band)' },
  gp: { vendor: 'Community self-hosted 3×V100' },
  stepfun: { vendor: 'stepfun plan endpoint' },
  claude: { vendor: 'Anthropic subscription lane' },
};
const lanes = rawLanes.map((lane) => ({ ...lane, ...laneLabels[lane.id] }));

// NA channel: `p` = effective passes, `n` = case slots (NA included), `na` = held/void cases,
// which count as neither a win nor a loss. `n === 0` means the lane never sat that axis (not
// the same as a hold). Chip full marks require every case slot to have passed, so a lane with
// any held case is not full — and a wholly held axis contributes no full marks (package G4).
const held = (cell) => cell.na ?? 0;
const usable = (cell) => (cell.n > 0 ? cell.n - held(cell) : 0);

const stats = faces.map(([id, label]) => {
  const available = lanes.filter((lane) => lane.axis[id].n > 0);
  const full = available.filter((lane) => lane.axis[id].p === lane.axis[id].n && held(lane.axis[id]) === 0);
  return { id, label, full: full.length, available: available.length };
});
---
<BaseLayout
  title="Rank models by work — AMBER benchmark"
  description="Choose models across eight work types with AMBER: 19 lanes, public scores, weakest-axis ordering and native browser filters."
  lang="en"
  canonicalPath="/en/rank/"
  keywords="AMBER, AI benchmark, model ranking, work types, axis matrix, AskClaw"
  schemaType="WebPage"
  schemaInLanguage="en"
>
  <div class="wrap rank-page" id="rank-app" data-lanes={JSON.stringify(lanes)} data-faces={JSON.stringify(faces)}>
    <h1>Rank models by work — <em>not just the total</em></h1>
    <p class="lead">
      Choose the types of work you need. The table compares the lowest pass count across your selected types first, then their combined pass count.
      This makes the differences between the 19 public lanes easier to check.
    </p>
    <noscript>Enable JavaScript to use the filters on this page.</noscript>

    <section class="section" aria-labelledby="pick-title">
      <h2 id="pick-title">Choose work types</h2>
      <p class="hint">Each chip shows how many lanes earned full marks for that type. No types are selected by default.</p>
      <div class="panel picker">
        <div class="chips" aria-label="Work-type filters">
          {stats.map(({ id, label, full, available }) => (
            <button class="chip" type="button" data-face={id} aria-pressed="false">
              {label}<span class="count">{full}/{available} full marks</span>
            </button>
          ))}
        </div>
        <div class="picker-bar">
          <div class="preset-list" aria-label="Presets">
            <button class="preset" type="button" data-preset="build,ops">Everyday engineering</button>
            <button class="preset" type="button" data-preset="build,ops,ui-build">All-round delivery</button>
            <button class="preset" type="button" data-preset="review,verify">Adversarial review</button>
            <button class="preset" type="button" data-preset="build,ops,text,req-drift">Budget work</button>
            <button class="preset" type="button" data-preset="build,ops,text,verify,review,req-drift,ui-build,vision">Select all</button>
          </div>
          <button class="clear-button" id="clear-rank" type="button">Clear</button>
        </div>
        <div class="verdict" id="rank-verdict" role="status">Nothing selected yet. Choose a work type to start.</div>
      </div>
    </section>

    <section class="section" aria-labelledby="board-title">
      <h2 id="board-title">Weakest-axis ranking</h2>
      <p class="hint">Rule: compare the lowest pass count first, then the combined pass count across the selected types. Ties are kept.</p>
      <div class="board-wrap">
        <table class="board">
          <caption class="sr-only">AMBER work-type ranking</caption>
          <thead><tr id="rank-head"></tr></thead>
          <tbody id="rank-body">
            <tr><td colspan="12">Choose a work type to display the lanes.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="saturation" id="rank-saturation" hidden></div>
      <p class="note rank-legend">' = contested (held for safety refusal) or invalid (infrastructure-related (test harness or scoring environment) cases: held, void or awaiting re-scoring); neither counts as a win or a loss. Every lane with NA carries an apostrophe, including frozen display rows; a hold does not settle the cause. Cell reading: effective passes / effective cases. A wholly held axis shows NA and stays out of the weakest-axis ranking and the full-marks count; a mixed axis shows the effective-case result with the held count listed beside it (NA n). Effective losses = case slots − passes − holds. Claude 17'/24: 17 wins · 6 losses · 1 test-harness infrastructure NA (A-1fd3683a; original answer not saved, zero-traffic gate misclassification; refusal is a diagnostic note only, deployment advice withdrawn by the owner). Luna high 16'/24: 16 wins · 4 losses · 4 held; UI / Vision / Review NA, not zero. StepFun 16'/24: 4 held cells, not losses. Week labels mean the baseline test week: Luna W37 (2026-09-07), StepFun W38 (2026-09-20); both add a separate W39 make-up (2026-09-21). Devin 19'/24 (1 NA); Doubao 17'/24 (3 NA); the frozen gpt-sol display is 15'/23∅ (3 NA), not /24. W39 newcomers: gpt-6-astra 16/24, gpt-6-sol 17/24, gpt-6-luna 15/24 (OpenAI Codex, all with no holds); mimo-v2.6-pro 17'/24 (1 scoring-environment invalid case held pending re-scoring, not a loss); space-bunny-alpha 15/24 (no NA).</p>
      <p class="note">Data comes from the public result repositories. Week labels follow the baseline test week; make-up weeks are disclosed separately. Case-set sizes stay on record. See the <a href={route('/method/')}>method (Chinese)</a> for the methodology and public hash index.</p>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  const app = document.querySelector('#rank-app');
  const lanes = JSON.parse(app.dataset.lanes);
  const faces = JSON.parse(app.dataset.faces);
  const selected = new Set();
  const chips = [...app.querySelectorAll('[data-face]')];
  const head = app.querySelector('#rank-head');
  const body = app.querySelector('#rank-body');
  const verdict = app.querySelector('#rank-verdict');
  const saturation = app.querySelector('#rank-saturation');

  const held = (cell) => cell.na ?? 0;
  const usable = (cell) => (cell.n > 0 ? cell.n - held(cell) : 0);
  const isAllHeld = (cell) => cell.n > 0 && usable(cell) === 0;
  const faceLabel = (id) => faces.find(([face]) => face === id)?.[1] ?? id;
  const laneCount = (id) => lanes.filter((lane) => lane.axis[id].n > 0).length;
  const fullCount = (id) => lanes.filter((lane) => lane.axis[id].p === lane.axis[id].n && held(lane.axis[id]) === 0).length;

  function setSelection(values) {
    selected.clear();
    values.forEach((value) => selected.add(value));
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(selected.has(chip.dataset.face))));
    render();
  }

  function appendCell(row, text, className = '') {
    const cell = document.createElement('td');
    cell.textContent = text;
    if (className) cell.className = className;
    row.append(cell);
  }

  function render() {
    const active = faces.map(([id]) => id).filter((id) => selected.has(id));
    head.replaceChildren();
    body.replaceChildren();
    saturation.hidden = true;
    saturation.textContent = '';

    if (active.length === 0) {
      const row = document.createElement('tr');
      appendCell(row, 'Choose a work type to display the lanes.');
      body.append(row);
      verdict.textContent = 'Nothing selected yet. Choose a work type to start.';
      return;
    }

    ['#', 'Lane (model × endpoint)', 'Total score'].forEach((label, index) => {
      const cell = document.createElement('th');
      cell.scope = 'col';
      cell.textContent = label;
      if (index === 2) cell.className = 'num';
      head.append(cell);
    });
    active.forEach((id) => {
      const cell = document.createElement('th');
      cell.scope = 'col';
      cell.className = 'num';
      cell.textContent = faceLabel(id);
      head.append(cell);
    });
    ['Weakest axis', 'Combined', 'Week / cases'].forEach((label) => {
      const cell = document.createElement('th');
      cell.scope = 'col';
      cell.className = 'num';
      cell.textContent = label;
      head.append(cell);
    });

    // A lane stays on the board when every selected axis has case slots, even if some axes are
    // wholly held. All-held axes leave the min/sum math (a hold is not a zero); a lane whose
    // selected axes are all held cannot be ordered and shows '—' outside the ranking.
    const rows = lanes
      .filter((lane) => active.every((id) => lane.axis[id].n > 0))
      .map((lane) => {
        const values = active.filter((id) => usable(lane.axis[id]) > 0).map((id) => lane.axis[id].p);
        return {
          lane,
          min: values.length ? Math.min(...values) : null,
          sum: values.length ? values.reduce((total, value) => total + value, 0) : null,
        };
      })
      .sort((a, b) => {
        if (a.min === null || b.min === null) return (a.min === null) - (b.min === null);
        return b.min - a.min || b.sum - a.sum;
      });

    if (rows.length === 0) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 6 + active.length;
      cell.textContent = 'No matching lanes. Try selecting fewer work types.';
      row.append(cell);
      body.append(row);
      verdict.textContent = 'No matching lanes. Try selecting fewer work types.';
      return;
    }

    rows.forEach(({ lane, min, sum }, index) => {
      const row = document.createElement('tr');
      appendCell(row, String(index + 1), 'rank-number');
      const laneCell = document.createElement('td');
      laneCell.className = 'lane';
      const link = document.createElement('a');
      link.href = `https://github.com/getaskclaw/${lane.repo}`;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = lane.name;
      laneCell.append(link);
      const vendor = document.createElement('small');
      vendor.textContent = lane.vendor;
      laneCell.append(vendor);
      row.append(laneCell);
      // Draft presentation only; release remains blocked on NA-aware data and ranking.
      const heldLane = Object.values(lane.axis).some((cell) => (cell.na ?? 0) > 0)
        || ["devin", "gpt-luna", "doubao", "claude", "stepfun", "gpt-sol"].includes(lane.id);
      const displayTotal = heldLane ? String(lane.total).replace(/'$/, '') + "'" : String(lane.total);
      appendCell(row, `${displayTotal}/${lane.n}`, 'num total');

      active.forEach((id) => {
        const value = lane.axis[id];
        const cell = document.createElement('td');
        cell.className = 'num';
        const span = document.createElement('span');
        if (isAllHeld(value)) {
          // Whole axis held: NA, and no part of the min/sum math.
          span.className = 'cell na';
          span.textContent = 'NA';
        } else {
          // Mixed axis: show the effective-case result (holds are not losses), then the
          // held count beside it.
          const eff = usable(value);
          span.className = `cell ${value.p === eff ? 'pass' : value.p === 0 ? 'fail' : ''}`;
          span.textContent = `${value.p}/${eff}`;
        }
        cell.append(span);
        if (held(value) > 0 && usable(value) > 0) {
          const note = document.createElement('span');
          note.className = 'na-note';
          note.textContent = `NA ${held(value)}`;
          cell.append(note);
        }
        row.append(cell);
      });

      appendCell(row, min === null ? '—' : String(min), min === null ? 'num min' : `num min ${min === 0 ? 'bad' : 'good'}`);
      appendCell(row, sum === null ? '—' : String(sum), 'num');
      const baselineWeek = lane.id === 'gpt-luna' ? 'W37' : lane.id === 'stepfun' ? 'W38' : lane.wk;
      appendCell(row, `${baselineWeek} · ${lane.n}`, 'num total');
      body.append(row);
    });

    const ranked = rows.filter((row) => row.min !== null);
    const best = ranked[0];
    const winners = best ? ranked.filter((row) => row.min === best.min) : [];
    const chosen = active.map(faceLabel).join(' + ');
    verdict.replaceChildren();
    verdict.append(document.createTextNode(`Selected: ${chosen}. Lowest pass count: `));
    const strong = document.createElement('strong');
    strong.textContent = best ? String(best.min) : '—';
    verdict.append(strong);
    verdict.append(document.createTextNode('. '));
    const names = winners.slice(0, 4).map((row) => row.lane.name).join(' / ');
    verdict.append(document.createTextNode(`Leading lanes: ${names}${winners.length > 4 ? ` (among ${winners.length} lanes)` : ''}.`));
    if (winners.length > 1) verdict.append(document.createTextNode(` ${winners.length} lanes tied.`));
    const unranked = rows.length - ranked.length;
    if (unranked > 0) verdict.append(document.createTextNode(` ${unranked} lane(s) are wholly held on the selected types and stay outside the ranking.`));

    const saturated = active.filter((id) => fullCount(id) > 0 && fullCount(id) === laneCount(id));
    if (saturated.length > 0) {
      saturation.hidden = false;
      saturation.textContent = `Note: all scored lanes currently have full marks for ${saturated.map(faceLabel).join(', ')}; these types do not change the ranking.`;
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const id = chip.dataset.face;
      if (selected.has(id)) selected.delete(id);
      else selected.add(id);
      chip.setAttribute('aria-pressed', String(selected.has(id)));
      render();
    });
  });

  app.querySelectorAll('[data-preset]').forEach((button) => {
    button.addEventListener('click', () => setSelection(button.dataset.preset.split(',').filter(Boolean)));
  });

  app.querySelector('#clear-rank').addEventListener('click', () => setSelection([]));
  render();
</script>
