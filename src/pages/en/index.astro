---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { route } from '../../utils/route';

const asset = (file: string) => route(`/assets/${file}`);

// Four-card hero, translated from the Chinese home (/src/pages/index.astro) and sharing its
// question-* / crab-* / leaderboard-* classes. A follows the Chinese page's repos anchor;
// D keeps the requested method-page entry path.
const crabAsset = asset('crab-hero.webp');

const questions = [
  {
    code: 'A',
    tone: 'teal',
    question: 'Same model — official endpoint vs third-party. Any difference?',
    preview: 'One model, compared lane by lane.',
    cue: 'See lanes',
    href: route('/method/#repos-title'),
    ariaLabel: 'Same model — official endpoint vs third-party. Any difference? One model, compared lane by lane. See the result repos.',
  },
  {
    code: 'B',
    tone: 'amber',
    question: 'Can the newly released models actually hold up?',
    preview: 'Same 24 cases; enter the board and see.',
    cue: 'See W39',
    href: route('/#leaderboard'),
    ariaLabel: 'Can the newly released models actually hold up? Same 24 cases; enter the board and see. See the 2026-W39 board.',
  },
  {
    code: 'C',
    tone: 'cobalt',
    question: 'Which model should I use for this kind of work?',
    preview: 'Pick the axis by work, not the total.',
    cue: 'Rank by axis',
    href: route('/en/rank/'),
    ariaLabel: 'Which model should I use for this kind of work? Pick the axis by work, not the total. Rank by work type.',
  },
  {
    code: 'D',
    tone: 'gold',
    question: 'Can this board itself be trusted?',
    preview: 'Sealed, clean-room, hash-checkable.',
    cue: 'Read the spec',
    href: route('/method/'),
    ariaLabel: 'Can this board itself be trusted? Sealed, clean-room, hash-checkable. Read the spec and the evidence chain.',
  },
] as const;

// #2 tie: the four lanes that sit at 18/24 after the convergence make-up. The CommandCode lane
// was frozen at the owner's call and is rendered separately below with its sealed 17/23 basis.
const tiedLanes = [
  ['glm-5.3-flash @ Ollama Cloud', 'teal', '18/24'],
  ['deepseek-v4.1-flash @ Ollama Cloud', 'sky', '18/24'],
  ['k3 @ Kimi official coding', 'coral', '18/24'],
  ['hy4-preview-f @ WorkBuddy', 'mint', '18/24'],
] as const;
const frozenLanes = [
  ['deepseek-v4.1-flash @ CommandCode', 'cobalt', '17/23 ∅'],
] as const;
// Published repository summaries, now on the /24 basis (amber README headline scores,
// commit 5be2ad08 onward). The axis picker keeps its own older W36 records for two lanes.
const repos = [
  ['amber', 'spec', 'Method spec + public hash index + cross-repo weekly board'],
  ['amber-devin', "19'/24", 'swe-2-max @ Devin — current leader'],
  ['amber-kimi', '18/24', 'k3 @ Kimi official coding endpoint + the K2.8 duel'],
  ['amber-ollama', '18/24', 'glm-5.3-flash / d41f @ Ollama Cloud'],
  ['amber-commandcode', '17/23 ∅', 'd41f @ CommandCode — frozen at the owner\'s call'],
  ['amber-workbuddy', '18/24', 'hy4-preview-f @ WorkBuddy ACP'],
  ['amber-gpt', '16/24', "gpt-6-astra 16/24 · 5.6-luna high 16'/24 · 5.6-sol high 15'/23 ∅ @ OpenAI Codex"],
  ['amber-crof', '16/23 ∅', 'qwen3.8-27b @ CrofAI — the $1.15 value king'],
  ['amber-deepseek', '17/24', 'deepseek-flash @ DeepSeek official'],
  ['amber-opencode', '17/24', 'deepseek-flash @ OpenCode Go'],
  ['amber-doubao', "17'/24", 'doubao-seed-evolving @ Volcengine Ark Agent Plan'],
  ['amber-stepfun', "16'/24", 'step-5-preview @ stepfun plan endpoint — W38 base + W39 convergence make-up'],
  ['amber-claude', "17'/24", 'Anthropic Claude subscription-lane model results'],
  ['amber-goldenpotato', '15/24', 'Qwen3.8-27B @ community self-hosted (3× V100)'],
];
---
<BaseLayout
  title="AskClaw — AMBER: sealed-in-amber replay evaluation"
  description="AMBER replays real, auditable historical events — frozen the moment before the answer was revealed. Private case library, public scores, independently checkable. A sealed-in-amber AI benchmark and leaderboard, updated weekly."
  lang="en"
  canonicalPath="/en/"
  keywords="AMBER, sealed-in-amber replay evaluation, AI benchmark, model leaderboard, AskClaw"
  schemaType="WebSite"
  schemaName="AskClaw — AMBER: sealed-in-amber replay evaluation"
  schemaInLanguage="en"
>
  <div class="wrap english-mirror">
    <section class="question-hero" aria-labelledby="question-heading">
      <div class="question-panel">
        <p class="eyebrow">AMBER / PUBLIC BENCHMARK</p>
        <div class="eyebrow-rule" aria-hidden="true"></div>
        <h1 id="question-heading">Which question do you want to start with?</h1>
        <div class="question-grid" aria-label="Four public data entry points">
          {questions.map((entry) => (
            <a
              class={`question-entry question-entry-${entry.tone}`}
              href={entry.href}
              aria-label={entry.ariaLabel}
            >
              <span class="question-meta">
                <span class="question-dot" aria-hidden="true"></span>
                <span>{entry.code}</span>
              </span>
              <span class="question-copy">
                <span class="question">{entry.question}</span>
                <span class="preview">{entry.preview}</span>
              </span>
              <span class="edge-cue">
                <span class="cue-mark" aria-hidden="true">{entry.code === 'D' ? '#' : '•'}</span>
                {entry.cue}
              </span>
            </a>
          ))}
        </div>
      </div>

      <aside class="crab-guide" aria-label="Hero guide">
        <div class="crab-frame">
          <img
            src={crabAsset}
            width="1200"
            height="400"
            alt="A coral crab holding a pearl, inviting visitors to view the AMBER 2026-W39 board"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <p class="crab-bubble">Ask one question; I'll hand you the path.</p>
        <div class="fact-rail" aria-label="AMBER current facts">
          <span class="fact-dot" aria-hidden="true"></span>
          <span>24 cases · 13 result repos · 2026-W39</span>
        </div>
      </aside>
    </section>

    <section class="leaderboard" id="leaderboard" aria-labelledby="leaderboard-title">
      <header class="leaderboard-header">
        <div>
          <h2 id="leaderboard-title">Current board</h2>
          <p>Real published scores · 2026-W39</p>
        </div>
        <span class="leaderboard-badge">24 cases · 13 result repos</span>
      </header>

      <div class="leaderboard-body">
        <article class="champion-card" aria-labelledby="champion-title">
          <div class="rank-label"><span class="rank-dot" aria-hidden="true"></span>#1 · Current leader</div>
          <div class="champion-main">
            <div>
              <h3 id="champion-title">swe-2-max @ Devin</h3>
              <p>Scored in W37 · convergence case folded in on W39</p>
            </div>
            <strong class="champion-score">19'/24</strong>
              <small>1 NA; not a win or a loss.</small>
          </div>
          <p class="champion-detail">Leader's score · 24-case library</p>
          <div class="progress-block">
            <div class="progress-track" role="img" aria-label="Leader passed 19 of 24 cases">
              <span style="width: 79.17%"></span>
            </div>
            <span>Cases passed / total cases in the library</span>
          </div>
        </article>

        <article class="tied-card" aria-labelledby="tied-title">
          <h3 id="tied-title">#2 · four-way tie · all 18/24</h3>
          <ol class="tied-list">
            {tiedLanes.map(([name, tone, score]) => (
              <li>
                <span class={`lane-marker lane-marker-${tone}`} aria-hidden="true"></span>
                <span class="lane-name" title={name}>{name}</span>
                <strong>{score}</strong>
              </li>
            ))}
          </ol>
          <p class="leaderboard-footnote">
            The former five-way 17/23 tie broke up in the convergence make-ups: k3 / glm-5.3-flash /
            v4.1-flash @ Ollama / hy4 now sit at 18/24, while the CommandCode lane was frozen at ∅
            at the owner's call and keeps its sealed 17/23 record.
          </p>
          <ol class="tied-list tied-list-frozen">
            {frozenLanes.map(([name, tone, score]) => (
              <li>
                <span class={`lane-marker lane-marker-${tone}`} aria-hidden="true"></span>
                <span class="lane-name" title={name}>{name}</span>
                <strong>{score}</strong>
              </li>
            ))}
          </ol>
        </article>
      </div>

      <footer class="leaderboard-footer">
        <strong>Same score ≠ same shape</strong>
        <span>The board gives the result first; the detail pages keep the evidence</span>
      </footer>
    </section>

    <section class="pending-section" aria-labelledby="pending-title">
      <header class="pending-header">
        <h2 id="pending-title">Still being filled in</h2>
        <p>Evidence first, then it comes back to the hero.</p>
      </header>
      <div class="pending-list">
        <div class="pending-row pending-row-e">
          <span class="pending-letter" aria-hidden="true">E</span>
          <div>
            <h3>Has the model gotten dumber?</h3>
            <p>Cross-vendor re-tests aren't complete; no capability regression is claimed yet.</p>
          </div>
          <span class="pending-status">data pending</span>
        </div>
        <div class="pending-row pending-row-f">
          <span class="pending-letter" aria-hidden="true">F</span>
          <div>
            <h3>A cheaper alternative for my workload?</h3>
            <p>Cheaper candidates need a systematic price / cost source.</p>
          </div>
          <span class="pending-status">pricing pending</span>
        </div>
      </div>
      <p class="pending-note">The secondary section only records the gaps; it doesn't pre-decide the data.</p>
    </section>

    <section class="hero">
      <h2 class="hero-heading"><em>AMBER</em> — real history,<br />sealed in amber, replayed</h2>
      <p class="lead">
        We take real, auditable incidents and freeze them at the moment before the answer was revealed.
        Models must redo the work with only what was knowable then, against a rubric frozen before any output existed.{' '}
        <b>The cases are never published. The scores always are.</b>
      </p>
      <div class="badges" aria-label="Evaluation facts">
        <div class="badge"><strong>24 cases / 27 papers</strong><small>private library, hash-sealed</small></div>
        <div class="badge"><strong>13 result repos</strong><small>one per vendor × endpoint</small></div>
        <div class="badge"><strong>Updated weekly</strong><small>same library, same band, public hash index</small></div>
      </div>
    </section>

    <section class="section" aria-labelledby="board-title">
      <h2 id="board-title">The board right now</h2>
      <p class="hint">
        Same band (high), same 24 cases, same public hash index. Five rank tiers; ties are labeled as ties.
        Glossary: case = one task (from a real incident); paper = one sitting; band = reasoning-effort level.
        These are static chart snapshots: open an image at full size, or follow its source details.
      </p>
      <figure>
        <a href={asset('top5-2026-w39.en.webp')} aria-label="Open full-size AMBER board">
          <img src={asset('top5-2026-w39.en.webp')} width="1400" height="1117" loading="lazy" alt="AMBER board: five rank tiers (2026-W39)" />
        </a>
        <figcaption>
          Snapshot 2026-W39 · leader swe-2-max @ Devin at 19'/24 (scored in W37, convergence folded in); the former five-way tie at 17/23 split into four lanes at 18/24.{' '}
          <a href="https://github.com/getaskclaw/amber">Board details →</a><br />
          <a href="https://github.com/getaskclaw/amber/blob/main/docs/corrections-2026-09-18.en.md">Correction 2026-09-18</a>:
          the bar now labeled "swe-2-high @ Devin (re-run)" was originally published as swe-2-low —
          that model does not exist; the server silently routed to swe-2-high.
          <a href="https://github.com/getaskclaw/amber/blob/main/docs/corrections-2026-09-21.en.md">Correction 2026-09-21</a>:
          astra's W36 UI-build cells were fallback-delivered, so its total is 16/24.<br />
          Note: the board artwork is the upstream W39 file, published before the convergence fold landed,
          so its axis still reads the 23-case basis while the scores above are on the 24-case basis.
        </figcaption>
      </figure>
    </section>

    <section class="section" aria-labelledby="matrix-title">
      <h2 id="matrix-title">Same score, different shape</h2>
      <p class="hint">
        The ten-axis completion matrix: each cell is a face's pin-level completion.
        Tied totals hide completely different profiles — the matrix shows what the sum can't.{' '}
        <a href={route('/en/rank/')}>Rank by work</a> uses eight work types and preserves each record's own week and case count.
      </p>
      <figure>
        <a href={asset('completion-matrix-7way.en.webp')} aria-label="Open full-size completion matrix">
          <img src={asset('completion-matrix-7way.en.webp')} width="1400" height="485" loading="lazy" alt="Ten-axis completion matrix" />
        </a>
        <figcaption>The former five-way 17/23 tie broke up in the convergence make-ups (k3 / glm-5.3-flash / v4.1-flash @ Ollama / hy4 at 18/24; CommandCode frozen at ∅), plus doubao 16/23 and gp27b 14/23. <a href="https://github.com/getaskclaw/amber">Matrix details →</a></figcaption>
      </figure>
    </section>

    <section class="section" aria-labelledby="trust-title">
      <h2 id="trust-title">Why the scores can be trusted</h2>
      <p class="hint">
        Every weekly issue runs like an exam: cases sealed in advance, a clean-room sitting,
        per-paper wire audits, anonymized publication, and a public index anyone can re-check.
      </p>
      <figure>
        <a href={asset('trust-chain.en.webp')} aria-label="Open full-size result production process">
          <img src={asset('trust-chain.en.webp')} width="1375" height="795" loading="lazy" alt="How a result is produced" />
        </a>
      </figure>
    </section>

    <section class="section" aria-labelledby="findings-title">
      <h2 id="findings-title">Three counterintuitive findings</h2>
      <p class="hint">Each comes with named boundaries and counterexamples in the original writeups.</p>
      <figure>
        <a href={asset('effort-curves-20260911.en.webp')} aria-label="Open full-size effort curves">
          <img src={asset('effort-curves-20260911.en.webp')} width="1400" height="781" loading="lazy" alt="Effort curves" />
        </a>
        <figcaption>"Think longer ≠ score better": most families backfire at top bands; swe-2 is monotone. <a href="https://github.com/getaskclaw/amber#readme">Effort findings →</a></figcaption>
      </figure>
      <figure>
        <a href={asset('score-vs-tokens-2026-w37.en.webp')} aria-label="Open full-size score and thinking budget chart">
          <img src={asset('score-vs-tokens-2026-w37.en.webp')} width="1400" height="849" loading="lazy" alt="Score vs thinking budget" />
        </a>
        <figcaption>Same band, same library: output-token bills span 17× while scores differ by one case. <a href="https://github.com/getaskclaw/amber#readme">Token findings →</a></figcaption>
      </figure>
      <figure>
        <a href={asset('wallclock-strip-2026-w37.en.webp')} aria-label="Open full-size per-case wall clock chart">
          <img src={asset('wallclock-strip-2026-w37.en.webp')} width="1400" height="803" loading="lazy" alt="Per-case wall clock" />
        </a>
        <figcaption>A vendor's high TPS only holds on easy problems; hard ones slow the token stream down.</figcaption>
      </figure>
    </section>

    <section class="section" aria-labelledby="repos-title">
      <h2 id="repos-title">Result repos</h2>
      <p class="hint">One repo per lane (model × endpoint × band), one matrix per week, wire audits and hash cross-checks included.</p>
      <p class="note">
        Scores are on the 24-case basis (convergence case folded in 2026-09-21). Two lanes are frozen
        at ∅ at the owner's call — CommandCode 17/23 and CrofAI 16/23 — so they keep their sealed
        earlier records. The axis picker retains its own older W36 records for two lanes.{' '}
        <a href={route('/method/')}>Read the method and score-period notes</a>.
      </p>
      <p class="note score-legend">' = contested (held for safety refusal) or invalid (infrastructure-related (test harness or scoring environment) cases: held, void or awaiting re-scoring); neither counts as a win or a loss. Every lane with NA carries an apostrophe, including frozen display rows; a hold does not settle the cause. Devin 19'/24 (1 NA); Doubao 17'/24 (3 NA); the frozen gpt-sol display is 15'/23∅ (3 NA), not /24.</p>
      <div class="repo-grid">
        {repos.map(([repo, score, description]) => (
          <a class="repo-card" href={`https://github.com/getaskclaw/${repo}`}>
            <strong>{repo}</strong>
            <span class="score">{score}</span>
            <small>{description}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="rules-title">
      <h2 id="rules-title">The rules</h2>
      <div class="rule-list">
        <div class="rule">Private side, never public: the case library, oracles, transcripts, internal case IDs and variant names.</div>
        <div class="rule">Public side, always checkable: scores, aggregates, verdicts, the hash index — anyone can verify the library didn't change and the scores add up.</div>
        <div class="rule">Historical outcomes are evidence, not the only correct answer; runtime sealing ≠ clean training data. Both warnings are printed on every issue.</div>
      </div>
      <p class="method-links">
        Read the method: <a href="https://github.com/getaskclaw/amber/blob/main/AMBER-Core-Specification.md">AMBER Core Specification</a> ·{' '}
        <a href="https://github.com/getaskclaw/amber/blob/main/hash-index/v2026-09.md">public hash index</a> ·{' '}
        <a href="https://github.com/getaskclaw/amber/blob/main/PLAN.md">roadmap</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* The top-of-page four-card hero owns the page's single <h1>; the legacy English strapline
     below stays visually identical to before, hence the explicit sizing. */
  .hero-heading {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 5vw, 2.6rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .hero-heading em {
    color: var(--teal);
    font-style: normal;
  }

  /* Scoped English-only difference from the shared card layout: the English cue labels
     ("Rank by axis", "Read the spec") are wider than the Chinese cue labels and
     the shared .edge-cue is nowrap. Because the card's cue column is an `auto` grid track, it
     sized to the cue's max-content and starved the preview column down to a few characters per
     line at 390px. Capping the cue width lets it wrap and gives the preview its column back. */
  .question-entry .edge-cue {
    max-width: 5.6em;
    white-space: normal;
  }

  figure {
    margin: 18px 0 28px;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
  }

  figcaption {
    margin-top: 8px;
    color: var(--sub);
    font-size: 0.85rem;
  }

  .repo-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    gap: 4px 12px;
  }

  .repo-card strong {
    overflow-wrap: anywhere;
  }

  .repo-card .score {
    float: none;
    font-variant-numeric: tabular-nums;
  }

  .repo-card small {
    grid-column: 1 / -1;
  }

  .method-links {
    margin-top: 18px;
    color: var(--sub);
    font-size: 0.92rem;
  }
</style>
