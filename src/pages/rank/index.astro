---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DotBoard from '../../components/DotBoard.astro';
import rawLanes from '../../data/axes.json';
import siteData from '../../data/site-data.json';
import { route } from '../../utils/route';

// Axes are data (amber.db axes.sql -> site-data.json): adding or splitting an axis needs no change here.
const faces = siteData.axes.map((a) => [a.id, a.name_zh]);
const allAxes = siteData.axes.map((a) => a.id).join(',');

// Keep the canonical records byte-for-byte. Only this lane's public vendor
// label is mapped; never substring-replace ordinary domain terminology.
const lanes = rawLanes.map((lane) => ({
  ...lane,
  vendor: lane.id === 'kimi' ? 'Kimi 官方 coding' : lane.vendor,
  name: lane.id === 'gpt-luna' ? 'gpt-5.6-luna-900k (high 档)' : lane.name,
}));

// NA channel: `p` = effective passes, `n` = case slots (NA included), `na` = held/void cases,
// which count as neither a win nor a loss. `n === 0` means the lane never sat that axis (not
// the same as a hold). Chip full marks require every case slot to have passed, so a lane with
// any held case is not full — and a wholly held axis contributes no full marks (package G4).
const held = (cell) => cell.na ?? 0;
const usable = (cell) => (cell.n > 0 ? cell.n - held(cell) : 0);

const stats = faces.map(([id, label]) => {
  const available = lanes.filter((lane) => lane.axis[id].n > 0);
  const full = available.filter((lane) => lane.axis[id].p === lane.axis[id].n && held(lane.axis[id]) === 0);
  return { id, label, full: full.length, available: available.length };
});
---
<BaseLayout
  title="按轴挑模型 — AMBER 琥珀评测"
  description={`AMBER 按八类工作筛选模型：${lanes.length} 条车道、公开成绩、短板排序和原生浏览器交互。`}
  canonicalPath="/rank/"
>
  <div class="wrap rank-page" id="rank-app" data-lanes={JSON.stringify(lanes)} data-faces={JSON.stringify(faces)}>
    <p class="note"><a href={route('/en/rank/')} lang="en" data-lang-switch="en">English version → /en/rank/</a></p>
    <h1>按轴挑模型 — <em>别只看总分</em></h1>
    <p class="lead">
      选择你要做的工作类型，下表先比较所选类型里的最低通过数，再比较合计。
      这让 {lanes.length} 条公开车道的差异更容易核对。
    </p>
    <noscript>本页的筛选需要启用 JavaScript。</noscript>

    <section class="section" aria-labelledby="dots-title">
      <h2 id="dots-title">全部车道一览</h2>
      <p class="hint">一点 = 一案（一道计分任务）。实心 = 通过，空心 = 未过，灰点 = NA（作废或挂起，不计胜负）。按总分排序，同分不分先后。多数轴只有 1–2 案，一案就能改变该轴读数。</p>
      <DotBoard lanes={lanes} lang="zh" />
    </section>

    <section class="section" aria-labelledby="pick-title">
      <h2 id="pick-title">选择工作类型</h2>
      <p class="hint">每个 chip 显示该类型里满分车道的数量；挂起案（NA）不计入满分统计。默认不选任何类型。</p>
      <div class="panel picker">
        <div class="chips" aria-label="工作类型筛选">
          {stats.map(({ id, label, full, available }) => (
            <button class="chip" type="button" data-face={id} aria-pressed="false">
              {label}<span class="count">{full}/{available} 满分</span>
            </button>
          ))}
        </div>
        <div class="picker-bar">
          <div class="preset-list" aria-label="预设">
            <button class="preset" type="button" data-preset="build,ops">日常开发</button>
            <button class="preset" type="button" data-preset="build,ops,ui-build">全栈开发</button>
            <button class="preset" type="button" data-preset="review,defense,attribution">对抗审查</button>
            <button class="preset" type="button" data-preset="build,ops,text,req-drift">省钱干活</button>
            <button class="preset" type="button" data-preset={allAxes}>全选</button>
          </div>
          <button class="clear-button" id="clear-rank" type="button">清空</button>
        </div>
        <div class="verdict" id="rank-verdict" role="status">还没有选择。先选一种工作类型。</div>
      </div>
    </section>

    <section class="section" aria-labelledby="board-title">
      <h2 id="board-title">短板排序</h2>
      <p class="hint">规则：先比最低通过数，再比所选类型的通过总数；并列会保留。整轴全挂起的格子不参加排序。</p>
      <div class="board-wrap">
        <table class="board">
          <caption class="sr-only">AMBER work-type ranking</caption>
          <thead><tr id="rank-head"></tr></thead>
          <tbody id="rank-body">
            <tr><td colspan="12">选择一种工作类型后显示车道。</td></tr>
          </tbody>
        </table>
      </div>
      <div class="saturation" id="rank-saturation" hidden></div>
      <p class="note rank-legend">' = contested（安全拒答挂起）、invalid（基建相关（考场 harness 或判分环境）的挂起、作废或待重评）或 integrity（作答时越出考卷、接触判分材料，作废；见 2026-10-02 更正），均不计胜负；所有含 NA 的道都带撇号，包括冻结展示行；挂起不表示死因已定。格子读法：有效案通过数／有效案数；整轴全挂起的格子显示 NA，不计满分；所选轴里有整轴挂起的车道没有可比成绩，不参加排序（显示 —）；混合格先给有效案结果，挂起案数另列（NA n），有效负 = 案槽 − 通过 − 挂起。2026-10-02 起防御案 A-d511f9e8 在所有车道上记 NA（见<a href="https://github.com/getaskclaw/amber/blob/main/docs/corrections-2026-10-02-a-d511f9e8.md">更正声明</a>）：每条道的总分都带撇号，过案数不变，下文「零 NA」「无挂起」均指这一案以外。claude-opus-5-5 两场并列：W39 17'/24（17 胜 · 6 负 · 1 案考场(harness)基建 NA，A-1fd3683a；原卷未落盘、零流量闸误判；拒答仅留诊断附注，owner 已签撤回部署建议；A-d511f9e8 改记 NA 后为 17 胜 · 5 负 · 2 NA）；W40 重考 19'/24（19 胜 · 2 负 · 3 案 NA：A-a317e74b、A-be92627f 两次作答都撞考场时间上限，按当时成文规则记 NA、不计负；第三案是 A-d511f9e8）。两场各考一次，考场不同，榜上只取 W40 一行。gpt-5.6-luna-900k (high 档) 16'/24（W37 旧道，与下文 W41 新道 gpt-5.6-luna-900k 是两条不同的道）：16 胜 · 3 负 · 5 挂起（含 A-d511f9e8），UI／视觉／审查 NA，不是零。step-5-preview 18'/24（W41，2026-10-06 重考；18 胜 · 3 负 · 3 NA：A-d511f9e8 全车道挂起；A-a317e74b、A-be92627f 两次作答都撞考场时间上限，记 NA、不计负。A-d9b79b46 在 2026-10-06 首考时以文本形式发出工具调用、未交付文件，当时按 2026-10-02 先例裁定为 NA；题面修订后单案重考，通过，现记通过。其他车道在这一案上的格子仍是旧题面下的结果，未重考）。周标签=基线考试周：luna high W37（2026-09-07），另列 W39 补测（2026-09-21）；step-5-preview 为 W41 单场。 Devin 19'/24（2 NA）；Doubao 17'/24（3 NA）；gpt-sol 冻结展示为 15'/23∅（4 NA），不改成 /24。W39 新入榜 5 道：gpt-6-astra 16'/24、gpt-6-sol 17'/24、gpt-6-luna-900k 15'/24（OpenAI Codex，除 A-d511f9e8 外均无挂起；W41 重考仍为 15'/24，周标签改 W41）；mimo-v2.6-pro 16'/24（1 案判分环境 invalid 挂起待重评，1 案越界作废，均不计负）；space-bunny-alpha 13'/24（2 案越界作废，另加 A-d511f9e8）。W40 新入榜：claude-sonnet-5-5 19'/24（除 A-d511f9e8 外零 NA）；claude-fable-5-1 16'/24（3 NA：A-d511f9e8 全车道挂起；A-be92627f 撞考场时间上限，A-d9b79b46 题面与考场不一致而挂起，待题面修复后全体重考，均不计负）；gpt-6.1-sol 16'/24（除 A-d511f9e8 外零 NA；上下文窗口按 272K 基础档）。W41 新入榜 OpenAI Codex 三道：gpt-5.6-luna 17'/24、gpt-5.6-luna-900k 16'/24、gpt-6-luna 16'/24，三道的 NA 都只有 A-d511f9e8（全车道挂起）；W41 的四条 luna 道里，gpt-5.6-luna、gpt-5.6-luna-900k、gpt-6-luna 过了 A-d9b79b46，gpt-6-luna-900k 没过。2026-10-06 的各场都在隔离考场里考，与 W37–W39 的格子不能逐格对照。W40 另有 WorkBuddy 直连道四条：deepseek-v4.1-flash 18'/24、glm-5.3-flash 17'/24、hy4-preview-f 16'/24、minimax-m3 16'/24；四条道的 NA 都含 A-d511f9e8 全车道挂起和 A-d9b79b46（题面与考场不一致而挂起，待题面修复后全体重考，不计负；minimax-m3 这一格最初记负，2026-10-05 改记 NA），hy4-preview-f 另有 A-be92627f 超时记 NA。2026-10-02 场次条件：Opus 与 gpt-6.1-sol 主场用镜像 v1，Fable 全场和 A-d511f9e8、A-a317e74b 的重考用镜像 v2（v2 = v1 + PyYAML）；A-d9b79b46 一题关考卷闸；超时新口径（端点正常的超时记负）待另发方法说明、自下一场起生效。2026-10-02 更正：9 张卷作答时越出考卷、接触判分材料，改记 NA——deepseek-v4.1-flash @ CommandCode 15'/23、deepseek-flash @ OpenCode Go 15'/24、deepseek-flash (GA) 16'/24 及 stepfun（W38 场次，已于 W41 重考）和上述 mimo、space-bunny。</p>
      <p class="note">数据来自公开成绩仓。周标签按基线考试周，补测周单独披露，案集案数保留；方法与公开哈希索引见 <a href={route('/method/')}>方法</a>。</p>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  const app = document.querySelector('#rank-app');
  const lanes = JSON.parse(app.dataset.lanes);
  const faces = JSON.parse(app.dataset.faces);
  const selected = new Set();
  const chips = [...app.querySelectorAll('[data-face]')];
  const head = app.querySelector('#rank-head');
  const body = app.querySelector('#rank-body');
  const verdict = app.querySelector('#rank-verdict');
  const saturation = app.querySelector('#rank-saturation');

  // NA channel: p = effective passes, n = case slots (NA included), na = held/void cases.
  // An all-held axis (n > 0, na === n) leaves the math; n === 0 means the lane never sat it.
  const held = (cell) => cell.na ?? 0;
  const usable = (cell) => (cell.n > 0 ? cell.n - held(cell) : 0);
  const isAllHeld = (cell) => cell.n > 0 && usable(cell) === 0;
  const faceLabel = (id) => faces.find(([face]) => face === id)?.[1] ?? id;
  const laneCount = (id) => lanes.filter((lane) => lane.axis[id].n > 0).length;
  const fullCount = (id) => lanes.filter((lane) => lane.axis[id].p === lane.axis[id].n && held(lane.axis[id]) === 0).length;

  function setSelection(values) {
    selected.clear();
    values.forEach((value) => selected.add(value));
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(selected.has(chip.dataset.face))));
    render();
  }

  function appendCell(row, text, className = '') {
    const cell = document.createElement('td');
    cell.textContent = text;
    if (className) cell.className = className;
    row.append(cell);
  }

  function render() {
    const active = faces.map(([id]) => id).filter((id) => selected.has(id));
    head.replaceChildren();
    body.replaceChildren();
    saturation.hidden = true;
    saturation.textContent = '';

    if (active.length === 0) {
      const row = document.createElement('tr');
      appendCell(row, '选择一种工作类型后显示车道。');
      body.append(row);
      verdict.textContent = '还没有选择。先选一种工作类型。';
      return;
    }

    ['#', '车道（模型 × 交付位置）', '总分'].forEach((label, index) => {
      const cell = document.createElement('th');
      cell.scope = 'col';
      cell.textContent = label;
      if (index === 2) cell.className = 'num';
      head.append(cell);
    });
    active.forEach((id) => {
      const cell = document.createElement('th');
      cell.scope = 'col';
      cell.className = 'num';
      cell.textContent = faceLabel(id);
      head.append(cell);
    });
    ['短板', '合计', '期 / 案数'].forEach((label) => {
      const cell = document.createElement('th');
      cell.scope = 'col';
      cell.className = 'num';
      cell.textContent = label;
      head.append(cell);
    });

    // A lane stays on the board when every selected axis has case slots, even if some axes
    // are wholly held. A hold is not a zero, and it is not a pass either: a lane with any
    // wholly held selected axis cannot be ordered and shows '—' outside the ranking.
    const rows = lanes
      .filter((lane) => active.every((id) => lane.axis[id].n > 0))
      .map((lane) => {
        // A wholly held selected axis has no result to compare, so the lane cannot be placed
        // against lanes that did sit it: it stays outside the ranking ('—') instead of being
        // ordered on the remaining axes, which would let a hold outrank a real pass.
        if (active.some((id) => usable(lane.axis[id]) === 0)) return { lane, min: null, sum: null };
        const values = active.map((id) => lane.axis[id].p);
        return {
          lane,
          min: Math.min(...values),
          sum: values.reduce((total, value) => total + value, 0),
        };
      })
      .sort((a, b) => {
        if (a.min === null || b.min === null) return (a.min === null) - (b.min === null);
        return b.min - a.min || b.sum - a.sum;
      });

    if (rows.length === 0) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 6 + active.length;
      cell.textContent = '无匹配车道，请减少筛选条件。';
      row.append(cell);
      body.append(row);
      verdict.textContent = '无匹配车道，请减少筛选条件。';
      return;
    }

    rows.forEach(({ lane, min, sum }, index) => {
      const row = document.createElement('tr');
      appendCell(row, min === null ? '—' : String(index + 1), 'rank-number');
      const laneCell = document.createElement('td');
      laneCell.className = 'lane';
      const link = document.createElement('a');
      link.href = `https://github.com/getaskclaw/${lane.repo}`;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = lane.name;
      laneCell.append(link);
      const vendor = document.createElement('small');
      vendor.textContent = lane.vendor;
      laneCell.append(vendor);
      row.append(laneCell);
      // Every lane carrying an NA cell takes the apostrophe, frozen display rows included.
      const heldLane = Object.values(lane.axis).some((cell) => held(cell) > 0)
        || ["devin", "gpt-luna", "doubao", "claude", "gpt-sol"].includes(lane.id);
      const displayTotal = heldLane ? String(lane.total).replace(/'$/, '') + "'" : String(lane.total);
      appendCell(row, `${displayTotal}/${lane.n}`, 'num total');

      active.forEach((id) => {
        const value = lane.axis[id];
        const cell = document.createElement('td');
        cell.className = 'num';
        const span = document.createElement('span');
        if (isAllHeld(value)) {
          // Whole axis held: NA, and no part of the min/sum math.
          span.className = 'cell na';
          span.textContent = 'NA';
        } else {
          // Mixed axis: show the effective-case result (holds are not losses), then the
          // held count beside it.
          const eff = usable(value);
          span.className = `cell ${value.p === eff ? 'pass' : value.p === 0 ? 'fail' : ''}`;
          span.textContent = `${value.p}/${eff}`;
        }
        cell.append(span);
        if (held(value) > 0 && usable(value) > 0) {
          const note = document.createElement('span');
          note.className = 'na-note';
          note.textContent = `NA ${held(value)}`;
          cell.append(note);
        }
        row.append(cell);
      });

      appendCell(row, min === null ? '—' : String(min), min === null ? 'num min' : `num min ${min === 0 ? 'bad' : 'good'}`);
      appendCell(row, sum === null ? '—' : String(sum), 'num');
      const baselineWeek = lane.id === 'gpt-luna' ? 'W37' : lane.wk;
      appendCell(row, `${baselineWeek} · ${lane.n}`, 'num total');
      body.append(row);
    });

    const ranked = rows.filter((row) => row.min !== null);
    const best = ranked[0];
    const winners = best ? ranked.filter((row) => row.min === best.min) : [];
    const chosen = active.map(faceLabel).join(' + ');
    verdict.replaceChildren();
    verdict.append(document.createTextNode(`已选：${chosen}。最低通过数 `));
    const strong = document.createElement('strong');
    strong.textContent = best ? String(best.min) : '—';
    verdict.append(strong);
    verdict.append(document.createTextNode('。'));
    const names = winners.slice(0, 4).map((row) => row.lane.name).join(' / ');
    verdict.append(document.createTextNode(`领先车道：${names}${winners.length > 4 ? ` 等 ${winners.length} 家` : ''}。`));
    if (winners.length > 1) verdict.append(document.createTextNode(`共 ${winners.length} 家并列。`));
    const unranked = rows.length - ranked.length;
    if (unranked > 0) verdict.append(document.createTextNode(`另有 ${unranked} 条道在所选轴里有整轴挂起，没有可比成绩，未参加排序。`));

    const saturated = active.filter((id) => fullCount(id) > 0 && fullCount(id) === laneCount(id));
    if (saturated.length > 0) {
      saturation.hidden = false;
      saturation.textContent = `提示：${saturated.map(faceLabel).join('、')} 当前所有车道均满分（挂起案不计），不改变排序。`;
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const id = chip.dataset.face;
      if (selected.has(id)) selected.delete(id);
      else selected.add(id);
      chip.setAttribute('aria-pressed', String(selected.has(id)));
      render();
    });
  });

  app.querySelectorAll('[data-preset]').forEach((button) => {
    button.addEventListener('click', () => setSelection(button.dataset.preset.split(',').filter(Boolean)));
  });

  app.querySelector('#clear-rank').addEventListener('click', () => setSelection([]));
  render();
</script>
